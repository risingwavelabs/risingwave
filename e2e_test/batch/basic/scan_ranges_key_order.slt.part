# Expected results below match PostgreSQL. A scan of several ranges provides key order, so these
# plans have no sort, and the order of the rows is what is checked.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table key_order_table(a int, b int, primary key(a, b));

statement ok
insert into key_order_table values (1,1),(1,2),(1,3),(1,null),(2,1),(2,2),(2,null),(3,1),(3,2),(4,5),(null,1),(null,2),(null,null);

statement ok
create materialized view key_order_asc as select a, b from key_order_table order by a, b limit 100;

statement ok
create materialized view key_order_desc as select a, b from key_order_table order by a desc, b desc limit 100;

statement ok
create materialized view key_order_nulls_first as select a, b from key_order_table order by a nulls first, b nulls first limit 100;

statement ok
create materialized view key_order_mixed as select a, b from key_order_table order by a, b desc limit 100;

