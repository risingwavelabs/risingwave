statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table t(v1 int, v2 int)

statement ok
insert into t values (4, 7), (9, 3), (10, 12), (1, 1), (10, 20), (4, 1), (-10, 100), (100, 10)

statement ok
create materialized view mv as select * from t order by v1 desc

query I rowsort
select v1, max(v2) from mv group by v1
----
-10 100
1 1
10 20
100 10
4 7
9 3


query II
select v1, max(v2) from t group by v1 order by v1 desc
----
100 10
10 20
9 3
4 7
1 1
-10 100

statement ok
drop materialized view mv

statement ok
drop table t

# Partial sort aggregation reduces rows before hash redistribution.
statement ok
create table files (company_id int, file_id int, primary key (company_id, file_id))

statement ok
insert into files
select 1, id from generate_series(1, 2048) as g(id)
union all
select 2, id from generate_series(1, 1024) as g(id)

query II
select count(*) as cnt, company_id from files group by company_id order by cnt desc limit 100
----
2048 1
1024 2

# Verify partial aggregation with many distinct group keys as well.
statement ok
insert into files select id + 2, 1 from generate_series(1, 1024) as g(id)

query I
select count(*) from (
  select company_id, count(*) as cnt from files group by company_id
) as grouped where cnt = 1
----
1024

statement ok
drop table files
