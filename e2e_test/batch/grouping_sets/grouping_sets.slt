create table empty_grouping_input (v int);

query III
SELECT count(*), count(v), sum(v) FROM empty_grouping_input GROUP BY GROUPING SETS (());
----
0 0 NULL

query III rowsort
SELECT count(*), count(v), sum(v) FROM empty_grouping_input GROUP BY GROUPING SETS ((), ());
----
0 0 NULL
0 0 NULL

query IIIIIII rowsort
SELECT v, grouping(v, v), count(*), count(v), sum(v), count(distinct v), count(*) FILTER (WHERE v < 0)
FROM empty_grouping_input GROUP BY GROUPING SETS ((), (v), ());
----
NULL 3 0 0 NULL 0 0
NULL 3 0 0 NULL 0 0

query I rowsort
SELECT count(*) FROM empty_grouping_input GROUP BY GROUPING SETS ((), ()) HAVING count(*) = 0;
----
0
0

query I
SELECT count(*) FROM empty_grouping_input GROUP BY GROUPING SETS ((), ()) HAVING count(*) > 0;
----

query I rowsort
SELECT 7 FROM empty_grouping_input GROUP BY GROUPING SETS ((), ());
----
7
7

query II rowsort
SELECT v, grouping(v) FROM empty_grouping_input GROUP BY GROUPING SETS ((v), ());
----
NULL 1

query III
SELECT v, grouping(v), count(*) FROM empty_grouping_input GROUP BY ROLLUP(v);
----
NULL 1 0

query III
SELECT v, grouping(v), count(*) FROM empty_grouping_input GROUP BY CUBE(v);
----
NULL 1 0

