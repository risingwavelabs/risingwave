# Decimals with up to 38 significant digits and up to 38 digits after the decimal point.

statement ok
SET RW_IMPLICIT_FLUSH TO true;

# Literals and text input keep up to 38 digits.
query RRRR
select
    12345678901234567890123456789012345678,
    -0.12345678901234567890123456789012345678,
    '79228162514264337593543950336'::decimal,
    '1.5e30'::decimal;
----
12345678901234567890123456789012345678 -0.12345678901234567890123456789012345678 79228162514264337593543950336 1500000000000000000000000000000

# Digits beyond the limits are rounded half away from zero. A value that rounds to one the former
# 28-digit range can hold keeps its former form.
query RRR
select
    1.23456789012345678901234567890123456785::decimal,
    '0.000000000000000000000000000000000000005'::decimal,
    '0.000000000000000000000000000000000000004'::decimal;
----
1.2345678901234567890123456789012345679 0.00000000000000000000000000000000000001 0.0000000000000000000000000000

statement error overflows
select 123456789012345678901234567890123456789::decimal;

statement error
select '1e38'::decimal;

# Scientific notation is rejected rather than rounded if the exponent makes the scale exceed 38.
query RR
select 1e-30, '1e-38'::decimal;
----
0.000000000000000000000000000001 0.00000000000000000000000000000000000001

statement error overflows
select 1.5e-38;

statement error
select '1e-1000'::decimal;

# Values in the former 28-digit range behave exactly as before, including the precision of results.
query RRR
select 1::decimal / 3, 2::decimal / 3, 1.000::decimal * 1.00;
----
0.3333333333333333333333333333 0.6666666666666666666666666667 1.00000

# Arithmetic that overflowed the former range now continues with up to 38 digits.
query RRRR
select
    79228162514264337593543950335::decimal + 1,
    79228162514264337593543950335::decimal * 1000,
    -79228162514264337593543950335::decimal - 0.5,
    1e31::decimal / 3;
----
79228162514264337593543950336 79228162514264337593543950335000 -79228162514264337593543950335.5 3333333333333333333333333333333.3333333

query RRRR
select
    12345678901234567890123456789012345678::decimal - 12345678901234567890123456789012345677,
    12345678901234567890123456789012345678::decimal % 1000,
    -12345678901234567890123456789012345678::decimal / 1e20,
    0.00000000000000000000000000000000000002::decimal * 0.5;
----
1 678 -123456789012345678.90123456789012345678 0.00000000000000000000000000000000000001

statement error out of range
select 99999999999999999999999999999999999999::decimal + 1;

statement error out of range
select 1e20::decimal * 1e20;

statement error Division by zero
select 1e30::decimal / 0;

# Special values.
query RRRR
select
    1e30::decimal + 'Infinity'::decimal,
    -1e30::decimal * 'Infinity'::decimal,
    1e30::decimal / 'Infinity'::decimal,
    1e30::decimal % '-Infinity'::decimal;
----
Infinity -Infinity 0 1000000000000000000000000000000

# Comparison and ordering mix both ranges.
query R
select v from (values
    ('NaN'::decimal), ('Infinity'), ('-Infinity'), (1e30), (-1e30), (79228162514264337593543950335),
    (0.00000000000000000000000000000000000001), (0), (-1.0000000000000000000000000000000000001)
) as t(v) order by v;
----
-Infinity
-1000000000000000000000000000000
-1.0000000000000000000000000000000000001
0
0.00000000000000000000000000000000000001
79228162514264337593543950335
1000000000000000000000000000000
Infinity
NaN

query TT
select
    2.0000000000000000000000000000000000001 - 0.0000000000000000000000000000000000001 = 2,
    1.0000000000000000000000000000000000001 > 1;
----
t t

# Functions.
query RRRRRR
select
    round(-1234567890123456789012345678.5678901234, 2),
    round(-1234567890123456789012345678.5678901234, -10),
    ceil(-1234567890123456789012345678.5678901234),
    floor(-1234567890123456789012345678.5678901234),
    trunc(-1234567890123456789012345678.5678901234),
    abs(-12345678901234567890123456789012345678);
----
-1234567890123456789012345678.57 -1234567890123456790000000000 -1234567890123456789012345678 -1234567890123456789012345679 -1234567890123456789012345678 12345678901234567890123456789012345678

query IIRR
select
    scale(1.0000000000000000000000000000000000100),
    min_scale(1.0000000000000000000000000000000000100),
    trim_scale(1.0000000000000000000000000000000000100),
    sign(-1e30);
----
37 35 1.00000000000000000000000000000000001 -1

query RRRR
select
    pow(2::decimal, 100),
    pow(10::decimal, -30),
    round(sqrt(2e30::decimal), 10),
    round(ln(1e30::decimal), 20);
----
1267650600228229401496703205376 0.000000000000000000000000000001 1414213562373095.0488016887 69.07755278982137052054

statement error overflow
select pow(10::decimal, 38);

# Casts.
query RRT
select
    12345678901234567890123456789012345678::decimal::float8,
    1e30::float8::decimal,
    1.0000000000000000000000000000000000001::decimal::varchar;
----
1.2345678901234568e+37 1000000000000000000000000000000 1.0000000000000000000000000000000000001

statement error out of range
select 1e30::decimal::int8;

# Aggregation, grouping and joins treat equal values alike regardless of their scale.
statement ok
create table decimal_38 (k decimal, v decimal);

statement ok
insert into decimal_38 values
    (1.000000000000000000000000000000000001, 50000000000000000000000000000),
    (1.000000000000000000000000000000000001 * 1.0, 50000000000000000000000000000),
    (79228162514264337593543950336, 1),
    (79228162514264337593543950336.00, 2),
    (1, 0.00000000000000000000000000000000000001);

# Which of two equal keys a group or `max` returns depends on the row order, so the keys are not
# selected as they are.
query IRR rowsort
select count(*), sum(v), max(v) from decimal_38 group by k;
----
1 0.00000000000000000000000000000000000001 0.00000000000000000000000000000000000001
2 100000000000000000000000000000 50000000000000000000000000000
2 3 2

# The sum is rounded to 38 significant digits.
query RRRT
select sum(v), avg(v), min(k), max(k) = 79228162514264337593543950336 from decimal_38;
----
100000000000000000000000000003.00000000 20000000000000000000000000000.6 1 t

query I
select count(*) from decimal_38 a join decimal_38 b on a.k = b.k;
----
9

statement ok
drop table decimal_38;
