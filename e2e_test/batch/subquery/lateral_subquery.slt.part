CREATE TABLE r(ts TIMESTAMPTZ, src_id int, dev_id int);

statement ok
INSERT INTO r VALUES
('2024-06-20T19:00:22Z'::TIMESTAMPTZ, 2, 2),
('2024-06-20T19:00:22Z'::TIMESTAMPTZ, 1, 3),
('2024-06-20T19:00:23Z'::TIMESTAMPTZ, 1, 2),
('2024-06-20T19:00:24Z'::TIMESTAMPTZ, 2, 1),
('2024-06-20T19:00:24Z'::TIMESTAMPTZ, 1, 2),
('2024-06-20T19:00:25Z'::TIMESTAMPTZ, 2, 1);

query TII rowsort
SELECT e.ts AS e_ts, d.*
FROM (
  SELECT '2024-06-20T19:01:00Z'::TIMESTAMPTZ ts, 1::INT AS src_id) e
JOIN LATERAL
(
  SELECT DISTINCT ON(src_id, dev_id) *
  FROM r
  WHERE r.src_id = e.src_id AND r.ts <= e.ts
  ORDER BY src_id, dev_id, ts DESC
)d on true;
----
2024-06-20 19:01:00+00:00 2024-06-20 19:00:22+00:00 1 3
2024-06-20 19:01:00+00:00 2024-06-20 19:00:24+00:00 1 2

statement ok
DROP TABLE r CASCADE;

# A lateral table function nested under another join can reference every enclosing left input.
# Duplicate outer rows verify that decorrelating nested Apply nodes preserves multiplicity.
statement ok
CREATE TABLE issue_12238_a(a1 INT);

statement ok
CREATE TABLE issue_12238_b(b1 INT);

statement ok
INSERT INTO issue_12238_a VALUES (1), (2), (2);

statement ok
INSERT INTO issue_12238_b VALUES (10), (20);

query III rowsort
SELECT a1, b1, x
FROM issue_12238_a,
  issue_12238_b CROSS JOIN UNNEST(ARRAY[a1, b1]) AS u(x);
----
1 10 1
1 10 10
1 20 1
1 20 20
2 10 10
2 10 10
2 10 2
2 10 2
2 20 2
2 20 2
2 20 20
2 20 20

# This mixed join tree cannot be fixed by reassociating pure cross joins.
query III rowsort
SELECT a1, b1, x
FROM issue_12238_a,
  issue_12238_b LEFT JOIN LATERAL (SELECT a1 + b1 AS x) z ON true;
----
1 10 11
1 20 21
2 10 12
2 10 12
2 20 22
2 20 22

statement ok
DROP TABLE issue_12238_a;

statement ok
DROP TABLE issue_12238_b;

# All FROM items of one query level share a namespace, so a lateral reference that matches an earlier
# FROM item and a join input is ambiguous, whichever way the FROM list is spelled.
statement ok
CREATE TABLE ambiguous_lateral_a(a1 INT);

statement ok
INSERT INTO ambiguous_lateral_a VALUES (1), (2);

statement error column reference "a1" is ambiguous
SELECT * FROM ambiguous_lateral_a, (SELECT 100 AS a1) t CROSS JOIN LATERAL (SELECT a1 AS y) z;

statement error column reference "a1" is ambiguous
SELECT * FROM ambiguous_lateral_a, (SELECT 100 AS a1) t, LATERAL (SELECT a1 AS y) z;

# An ambiguous lateral reference must not resolve to the outer query's column.
statement error column reference "a1" is ambiguous
SELECT (SELECT y FROM (SELECT 100 AS a1) t1, (SELECT 200 AS a1) t2, LATERAL (SELECT a1 AS y) z)
FROM ambiguous_lateral_a;

statement ok
DROP TABLE ambiguous_lateral_a;

# A lateral item after a left FROM item may reference columns of enclosing queries.
statement ok
CREATE TABLE lateral_outer_a(a1 INT);

statement ok
CREATE TABLE lateral_outer_b(b1 INT);

statement ok
CREATE TABLE lateral_outer_t1(x INT);

statement ok
CREATE TABLE lateral_outer_t2(y INT);

