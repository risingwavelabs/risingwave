statement ok
SET QUERY_MODE TO distributed;

statement ok
create table t (a int, b int, id int, primary key (a, b, id));

statement ok
insert into t select 10, id % 16, id from generate_series(0, 63) as s(id);

query II
select b, id from t where a = 10 order by b, id limit 3 offset 31;
----
7 55
8 8
8 24

query I
select b from t where a = 10 order by b fetch first 5 rows with ties;
----
0
0
0
0
1
1
1
1

statement ok
create index idx_ab on t(a, b desc, id);

statement ok
insert into t values (11, 99, 1);

query III
select id, a, b from t where a = 10 and id % 3 = 1 order by b desc, id limit 3;
----
31 10 15
46 10 14
13 10 13

statement ok
insert into t select 12, i, i from generate_series(1, 2048) as s(i);

query III
select count(*), min(b), max(b) from (
  select b from t where a = 12 order by b desc limit 1025 offset 5
) as page;
----
1025 1019 2043

