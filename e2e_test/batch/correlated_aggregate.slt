NULL 0 0

statement ok
DROP MATERIALIZED VIEW correlated_count_mv;

# Broadening the domain must preserve duplicate and NULL outer keys.
query III rowsort
SELECT s.id,
  (SELECT count(*) FROM correlated_aggregate_facts f WHERE f.id = s.id),
  (SELECT sum(f.amount) FROM correlated_aggregate_facts f WHERE f.id = s.id)
FROM (SELECT id FROM correlated_aggregate_outer ORDER BY id LIMIT 5) s;
----
1 2 30
1 2 30
2 1 5
3 0 NULL
NULL 0 NULL

# The same rewrite must preserve streaming empty groups as matches appear and disappear.
statement ok
CREATE MATERIALIZED VIEW correlated_aggregate_mv AS
SELECT s.id, a.total
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a;

query II rowsort
SELECT * FROM correlated_aggregate_mv;
----
1 30
1 30
2 5
3 NULL
NULL NULL

