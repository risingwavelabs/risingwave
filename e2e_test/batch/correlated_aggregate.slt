# Every sampled key has sum 5. Assert this invariant without depending on the random keys.
statement ok
SET query_mode TO local;

query IIII
SELECT count(*), count(total), min(total), max(total)
FROM (
  SELECT s.id,
    (SELECT sum(f.amount) FROM correlated_aggregate_facts f WHERE f.id = s.id) AS total
  FROM (SELECT id FROM correlated_aggregate_outer ORDER BY random() LIMIT 50) s
) q;
----
50 50 5 5

statement ok
