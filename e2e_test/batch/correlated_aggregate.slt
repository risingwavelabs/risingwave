# Scalar aggregates must preserve unmatched outer rows, including through INNER LATERAL.
statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
CREATE TABLE correlated_aggregate_outer (id int);

statement ok
CREATE TABLE correlated_aggregate_facts (id int, amount int);

statement ok
INSERT INTO correlated_aggregate_outer VALUES (1), (1), (2), (3), (NULL);

statement ok
INSERT INTO correlated_aggregate_facts VALUES (1, 10), (1, 20), (2, 5), (NULL, 100);

query II rowsort
SELECT s.id, a.total
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a;
----
1 30
1 30
2 5
3 NULL
NULL NULL

# The original INNER LATERAL ON must filter matched groups as well as the empty aggregate row.
query II rowsort
SELECT s.id, a.total
FROM correlated_aggregate_outer s
JOIN LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a ON a.total IS NULL;
----
3 NULL
NULL NULL

query II rowsort
SELECT s.id, a.total
FROM correlated_aggregate_outer s
JOIN LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a ON a.total > 10;
----
1 30
1 30

# A null-rejecting WHERE predicate may still eliminate empty groups.
query II rowsort
SELECT s.id, a.total
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a
WHERE a.total > 10;
----
1 30
1 30

# LEFT LATERAL ON retains unmatched rows, unlike the INNER LATERAL cases above.
query II rowsort
SELECT s.id, a.total
FROM correlated_aggregate_outer s
LEFT JOIN LATERAL (
  SELECT sum(f.amount) AS total FROM correlated_aggregate_facts f WHERE f.id = s.id
) a ON a.total > 10;
----
1 30
1 30
2 NULL
3 NULL
NULL NULL

# Aggregates that are not null over empty input, such as COUNT, keep that value for outer rows
# without matching rows, including NULL outer keys. So do expressions over the aggregates.
query II rowsort
SELECT s.id, (SELECT count(*) FROM correlated_aggregate_facts f WHERE f.id = s.id)
FROM correlated_aggregate_outer s;
----
1 2
1 2
2 1
3 0
NULL 0

query IIIII rowsort
SELECT s.id, a.n, a.n_big, a.total, a.n_plus_one
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT count(*) AS n,
    count(f.amount) FILTER (WHERE f.amount > 10) AS n_big,
    coalesce(sum(f.amount), 0) AS total,
    count(*) + 1 AS n_plus_one
  FROM correlated_aggregate_facts f WHERE f.id = s.id
) a;
----
1 2 1 30 3
1 2 1 30 3
2 1 0 5 2
3 0 0 0 1
NULL 0 0 0 1

query IBR rowsort
SELECT s.id, a.no_distinct, a.average
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT approx_count_distinct(f.amount) = 0 AS no_distinct, avg(f.amount) AS average
  FROM correlated_aggregate_facts f WHERE f.id = s.id
) a;
----
1 f 15
1 f 15
2 f 5
3 t NULL
NULL t NULL

query IT rowsort
SELECT s.id,
  ARRAY(SELECT f.amount FROM correlated_aggregate_facts f WHERE f.id = s.id ORDER BY f.amount)
FROM correlated_aggregate_outer s;
----
1 {10,20}
1 {10,20}
2 {5}
3 {}
NULL {}

query I rowsort
SELECT s.id FROM correlated_aggregate_outer s
WHERE (SELECT count(*) FROM correlated_aggregate_facts f WHERE f.id = s.id) = 0;
----
3
NULL

query I rowsort
SELECT s.id FROM correlated_aggregate_outer s
WHERE 0 IN (SELECT count(*) FROM correlated_aggregate_facts f WHERE f.id = s.id);
----
3
NULL

# An aggregate without GROUP BY returns one row even for empty input, so EXISTS is always true.
query I rowsort
SELECT s.id FROM correlated_aggregate_outer s
WHERE EXISTS (SELECT sum(f.amount) FROM correlated_aggregate_facts f WHERE f.id = s.id);
----
1
1
2
3
NULL

query I rowsort
SELECT s.id FROM correlated_aggregate_outer s
WHERE NOT EXISTS (SELECT sum(f.amount) FROM correlated_aggregate_facts f WHERE f.id = s.id);
----

statement ok
CREATE MATERIALIZED VIEW correlated_count_mv AS
SELECT s.id, a.n, a.total
FROM correlated_aggregate_outer s,
LATERAL (
  SELECT count(*) AS n, coalesce(sum(f.amount), 0) AS total
  FROM correlated_aggregate_facts f WHERE f.id = s.id
) a;

query III rowsort
SELECT * FROM correlated_count_mv;
----
1 2 30
1 2 30
2 1 5
3 0 0
NULL 0 0

