FROM correlated_aggregate_outer s WHERE random() < 0.5;

query III
SELECT count(*), min(n), max(n)
FROM (
  SELECT s.id,
    (SELECT count(*) FROM correlated_aggregate_facts f WHERE f.id = s.id) AS n
  FROM (SELECT id FROM correlated_aggregate_outer ORDER BY id LIMIT 50) s
) q;
----
50 2 2

statement error correlated subquery would evaluate an outer LIMIT or TopN more than once
