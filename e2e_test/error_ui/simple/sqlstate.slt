# SQLSTATE coverage tests for supported error codes.

# Duplicate object -> 42710.
statement ok
create table sqlstate_slt_dup(v int);

statement error (42710)
create table sqlstate_slt_dup(v int);

statement ok
drop table sqlstate_slt_dup;

# Undefined object -> 42704.
statement ok
drop table if exists sqlstate_slt_no_such;

statement error (42704)
drop table sqlstate_slt_no_such;

# Wrong object type -> 42809.
statement ok
create table sqlstate_slt_wrong_type(v int);

statement ok
create view sqlstate_slt_wrong_type_v as select 1 as v;

statement error (42809)
drop view sqlstate_slt_wrong_type;

statement error (42809)
drop table sqlstate_slt_wrong_type_v;

statement error (42809)
insert into sqlstate_slt_wrong_type_v values (1);

statement ok
drop view sqlstate_slt_wrong_type_v;

statement ok
drop table sqlstate_slt_wrong_type;

# Invalid catalog name (database) -> 3D000.
statement error (3D000)
set database to sqlstate_missing_db;
