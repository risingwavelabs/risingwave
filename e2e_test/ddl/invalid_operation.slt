# 4.4 table with connector
statement ok
create table msrc (v int) with (
    connector = 'datagen',
    fields.v.kind = 'sequence',
    fields.v.start = '1',
    fields.v.end  = '10',
    datagen.rows.per.second='15',
    datagen.split.num = '1'
) FORMAT PLAIN ENCODE JSON;

statement error Use `DROP TABLE`
drop materialized view msrc;

statement error Use `DROP TABLE`
