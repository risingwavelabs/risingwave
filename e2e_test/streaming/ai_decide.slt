# SQL NULL arguments do not make a request, even with an invalid endpoint.
query T
SELECT ai_decide(NULL::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key');
----
NULL

# The function accepts exactly five arguments, including when state is NULL.
statement error ai_decide expects exactly five arguments
SELECT ai_decide(NULL::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', '{"max_concurrency":16}'::jsonb);

statement error ai_decide expects exactly five arguments
SELECT ai_decide(NULL::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', NULL::jsonb);

query T
SELECT CASE WHEN false THEN (ai_decide('{}'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key')).q ELSE 0::float8 END;
----
0

# JSON null is a real input, unlike SQL NULL. An outer expression must not hide failures.
statement error ai_decide: invalid model_url
SELECT coalesce((ai_decide('null'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key')).q, 0);

# The fixture uses a real local HTTP server and psql, which cannot run under madsim.
skipif madsim
system ok
python3 e2e_test/streaming/ai_decide_http.py
----
ai_decide HTTP integration passed
