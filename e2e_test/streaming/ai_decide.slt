# SQL NULL arguments do not make a request, even with an invalid endpoint.
query T
SELECT ai_decide(NULL::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key');
----
NULL

query T
SELECT CASE WHEN false THEN (ai_decide('{}'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key')).q ELSE 0::float8 END;
----
0

# JSON null is a real input. Request-construction errors follow ordinary strictness.
statement ok
SET batch_expr_strict_mode = true;

statement error ai_decide: invalid model_url
SELECT coalesce((ai_decide('null'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key')).q, 0);

statement ok
SET batch_expr_strict_mode = false;

query R
SELECT coalesce((ai_decide('null'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key')).q, -1);
----
-1

statement ok
SET batch_expr_strict_mode TO DEFAULT;

# A NULL map skips evaluation; header errors are local expression errors.
query T
SELECT ai_decide('{}'::jsonb, 'invalid', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', NULL::map(varchar, varchar));
----
NULL

statement ok
SET batch_expr_strict_mode = true;

statement error headers must not override Authorization
SELECT ai_decide('{}'::jsonb, 'http://127.0.0.1:1', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', MAP {'aUtHoRiZaTiOn': 'test-conflict'});

statement error header values must not be NULL
SELECT ai_decide('{}'::jsonb, 'http://127.0.0.1:1', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', MAP {'X-Tenant-ID': NULL::varchar});

statement error invalid header name
SELECT ai_decide('{}'::jsonb, 'http://127.0.0.1:1', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', MAP {'invalid name': 'test-value'});

statement error invalid header value
SELECT ai_decide('{}'::jsonb, 'http://127.0.0.1:1', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', MAP {'X-Tenant-ID': E'test\nvalue'});

statement error duplicate case-insensitive header name
SELECT ai_decide('{}'::jsonb, 'http://127.0.0.1:1', 'test-model', ai_questions(ai_prob_question('q', 'Question?')), 'test-key', MAP {'X-Tenant': 'one', 'x-tenant': 'two'});

statement ok
SET batch_expr_strict_mode TO DEFAULT;

# The fixture uses a real local HTTP server and psql, which cannot run under madsim.
skipif madsim
system ok
python3 e2e_test/streaming/ai_decide_http.py
----
ai_decide HTTP integration passed
