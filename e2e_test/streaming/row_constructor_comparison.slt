query IIT rowsort
select * from mv_project;
----
1 5 f
1 6 t
1 7 t
1 8 t
2 NULL t
2 NULL t
3 NULL t

query II rowsort
select * from mv_join;
----
2 2

statement ok
drop materialized view mv_gt;

statement ok
