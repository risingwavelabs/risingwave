# Row constructor comparisons in streaming jobs, with retractions. Expected results match PostgreSQL.

statement ok
set rw_implicit_flush to true;

statement ok
create table n(a int, b int);

statement ok
insert into n values (1,3),(1,5),(1,6),(2,0),(null,1),(1,null),(2,null),(null,null);

statement ok
create table l(a int, b int);

statement ok
insert into l values (1,null),(null,1),(1,2),(null,null);

statement ok
create table r(x int, y int);

statement ok
insert into r values (1,null),(null,1),(1,2),(null,null);

statement ok
create materialized view mv_gt as select a, b from n where (a, b) > (1, 5);

statement ok
create materialized view mv_ne as select a, b from n where (a, b) <> (1, 5);

statement ok
create materialized view mv_in as select a, b from n where (a, b) in ((1, 5), (1, null::int));

statement ok
create materialized view mv_project as select a, b, (a, b) > (1, 5) as v from n;

statement ok
create materialized view mv_join as select l.a, l.b from l join r on (l.a, l.b) = (r.x, r.y);

query II rowsort
select * from mv_gt;
----
1 6
2 0
2 NULL

query II rowsort
select * from mv_ne;
----
1 3
1 6
2 0
2 NULL
NULL 1

query II rowsort
select * from mv_in;
----
1 5

query IIT rowsort
select * from mv_project;
----
1 3 f
1 5 f
1 6 t
1 NULL NULL
2 0 t
2 NULL t
NULL 1 NULL
NULL NULL NULL

query II rowsort
select * from mv_join;
----
1 2

statement ok
insert into n values (1, 7), (3, null), (null, 9);

statement ok
insert into l values (2, 2), (2, null);

statement ok
insert into r values (2, 2), (2, null);

statement ok
delete from n where a = 1 and b is null;

statement ok
delete from n where a is null;

statement ok
update n set b = null where a = 2;

statement ok
update n set b = 8 where a = 1 and b = 3;

statement ok
delete from l where a = 1;

statement ok
delete from r where x is null;

query II rowsort
