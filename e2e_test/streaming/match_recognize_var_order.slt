# Pattern variables whose order of appearance differs from their sorted order.
#
# The executor interns pattern variables by sorted name (`a` < `m` < `z`) while the pattern lists
# them as `z m+ a`, so every name-based path — the DEFINE of the middle variable navigating a
# SUBSET, CLASSIFIER, FIRST/LAST over the SUBSET in MEASURES, COUNT over one variable, and both
# variable-targeted skips — must agree on which id is which. A wrong mapping would surface here as
# a wrong classifier, a wrong navigation value, or a wrong resume point.

statement ok
set streaming_parallelism = 1;

statement ok
set rw_implicit_flush to true;

statement ok
create table t (id int, ts int, v int, watermark for ts as ts - 10) append only;

# `z` has no DEFINE (any row), `m` must exceed the match's first `u` row (the `z`), `a` is negative.
statement ok
create materialized view mv_last as
select * from t match_recognize (
  partition by id
  order by ts
  measures classifier() as cls, first(u.v) as fu, last(u.v) as lu, count(m.v) as nm
  one row per match
  after match skip to last m
  pattern (z m+ a)
  subset u = (z, a)
  define m as m.v > first(u.v), a as a.v < 0
);

statement ok
create materialized view mv_first as
select * from t match_recognize (
  partition by id
  order by ts
  measures classifier() as cls, first(u.v) as fu, last(u.v) as lu, count(m.v) as nm
  one row per match
  after match skip to first m
  pattern (z m+ a)
  subset u = (z, a)
  define m as m.v > first(u.v), a as a.v < 0
);

# id=1: 1, 5, 7, -1, 2, -3.
#   Rows 1..4 match as z(1) m(5) m(7) a(-1): cls 'a', first(u) 1, last(u) -1, count(m) 2.
#   SKIP TO LAST m resumes at row 3 (7): 7 z, then -1 is neither m (-1 > 7) nor allowed as `a`
#   without an `m` — dead. Row 4 (-1) as z: 2 is m (2 > -1), -3 is a: cls 'a', -1, -3, 1.
#   SKIP TO FIRST m resumes at row 2 (5): z(5) m(7) a(-1): cls 'a', 5, -1, 1; then from row 3
#   dead as above; then the (4, 5, 6) match as before.
# id=0 ts=100: sentinel pushing the watermark to 90 so everything above finalizes.
statement ok
insert into t values
  (1, 1, 1), (1, 2, 5), (1, 3, 7), (1, 4, -1), (1, 5, 2), (1, 6, -3),
  (0, 100, 0);

query ITIII rowsort
select * from mv_last;
----
1 a -1 -3 1
1 a 1 -1 2

query ITIII rowsort
select * from mv_first;
----
1 a -1 -3 1
1 a 1 -1 2
1 a 5 -1 1

statement ok
drop materialized view mv_last;

statement ok
drop materialized view mv_first;

statement ok
drop table t;
