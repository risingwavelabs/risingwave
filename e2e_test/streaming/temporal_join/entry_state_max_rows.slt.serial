# Deleting a left row retracts exactly the rows it was joined with.
statement ok
DELETE FROM events WHERE id IN (1, 4);

query IIII rowsort
SELECT * FROM joined;
----
2 200 1 40
3 101 1 10
3 101 3 30
3 101 4 50

query IIII rowsort
SELECT * FROM joined_broadcast;
----
2 200 1 40
3 101 1 10
3 101 3 30
3 101 4 50

statement ok
DROP MATERIALIZED VIEW joined;

statement ok
DROP MATERIALIZED VIEW joined_broadcast;

statement ok
DROP MATERIALIZED VIEW joined_append_only;

statement ok
DROP MATERIALIZED VIEW joined_append_only_broadcast;

statement ok
DROP TABLE events;

statement ok
DROP TABLE append_events;

statement ok
DROP INDEX dimensions_by_k;

statement ok
DROP TABLE dimensions;
