# Windows of `SESSION` and `RANGE` frames are closed by the watermark, without later rows of the
# partition. Rows of `bar = 2` only advance the watermark.

statement ok
set RW_IMPLICIT_FLUSH to true;

statement ok
set streaming_parallelism = 1;

statement ok
create table t (
    tm timestamp,
    foo int,
    bar int,
    watermark for tm as tm - interval '5 minutes'
) append only;

statement ok
set streaming_parallelism = 0;

statement ok
create materialized view mv_session as
select
    tm, foo, bar,
    count(*) over (partition by bar order by tm session with gap '10 minutes') as cnt
from t
emit on window close;

statement ok
create materialized view mv_range as
select
    tm, foo, bar,
    sum(foo) over (
        partition by bar order by tm
        range between current row and interval '2 minutes' following
    ) as next_2min_sum
from t
emit on window close;

statement ok
create materialized view mv_range_preceding as
select
    tm, foo, bar,
    sum(foo) over (
        partition by bar order by tm
        range between interval '10 minutes' preceding and interval '5 minutes' preceding
    ) as prev_sum
from t
emit on window close;

# Watermark 10:02 equals the frame end of 10:00, where a row may still come.
statement ok
insert into t values
  ('2023-05-06 10:00:00', 1, 1)
, ('2023-05-06 10:01:00', 2, 1)
, ('2023-05-06 10:00:00', 3, 3)
, ('2023-05-06 10:07:00', 0, 2);

query TIII
select * from mv_range where bar = 1 order by tm;
----

# A frame ending before the current row is closed once the row arrives.
query TIII
select * from mv_range_preceding where bar = 3 order by tm;
----
2023-05-06 10:00:00 3 3 NULL

# Watermark 10:03 closes the frame of 10:00.
statement ok
insert into t values ('2023-05-06 10:08:00', 0, 2);

query TIII
select * from mv_range where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 3

query TIII
select * from mv_session where bar = 1 order by tm;
----

# Watermark 10:11 equals the minimal start of the next session, so the session is closed.
statement ok
insert into t values ('2023-05-06 10:16:00', 0, 2);

query TIII
select * from mv_session where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 2
2023-05-06 10:01:00 2 1 2

query TIII
select * from mv_range where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 3
2023-05-06 10:01:00 2 1 2

statement ok
drop materialized view mv_session;

statement ok
drop materialized view mv_range;

statement ok
drop materialized view mv_range_preceding;

statement ok
drop table t;
