# Windows of `SESSION` and `RANGE` frames are closed by the watermark, without later rows of the
# partition. Rows of `bar = 2` only advance the watermark.

statement ok
set RW_IMPLICIT_FLUSH to true;

statement ok
set streaming_parallelism = 1;

statement ok
create table t (
    tm timestamp,
    foo int,
    bar int,
    watermark for tm as tm - interval '5 minutes'
) append only;

statement ok
set streaming_parallelism = 0;

statement ok
create materialized view mv_session as
select
    tm, foo, bar,
    count(*) over (partition by bar order by tm session with gap '10 minutes') as cnt
from t
emit on window close;

statement ok
create materialized view mv_range as
select
    tm, foo, bar,
    sum(foo) over (
        partition by bar order by tm
        range between current row and interval '2 minutes' following
    ) as next_2min_sum
from t
emit on window close;

statement ok
create materialized view mv_range_preceding as
select
    tm, foo, bar,
    sum(foo) over (
        partition by bar order by tm
        range between interval '10 minutes' preceding and interval '5 minutes' preceding
    ) as prev_sum
from t
emit on window close;

# Watermark 10:02 equals the frame end of 10:00, where a row may still come.
statement ok
insert into t values
  ('2023-05-06 10:00:00', 1, 1)
, ('2023-05-06 10:01:00', 2, 1)
, ('2023-05-06 10:00:00', 3, 3)
, ('2023-05-06 10:07:00', 0, 2);

query TIII
select * from mv_range where bar = 1 order by tm;
----

# A frame ending before the current row is closed once the row arrives.
query TIII
select * from mv_range_preceding where bar = 3 order by tm;
----
2023-05-06 10:00:00 3 3 NULL

# Watermark 10:03 closes the frame of 10:00.
statement ok
insert into t values ('2023-05-06 10:08:00', 0, 2);

query TIII
select * from mv_range where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 3

query TIII
select * from mv_session where bar = 1 order by tm;
----

# Watermark 10:11 equals the minimal start of the next session, so the session is closed.
statement ok
insert into t values ('2023-05-06 10:16:00', 0, 2);

query TIII
select * from mv_session where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 2
2023-05-06 10:01:00 2 1 2

query TIII
select * from mv_range where bar = 1 order by tm;
----
2023-05-06 10:00:00 1 1 3
2023-05-06 10:01:00 2 1 2

statement ok
drop materialized view mv_session;

statement ok
drop materialized view mv_range;

statement ok
drop materialized view mv_range_preceding;

statement ok
drop table t;

# The end of a session doesn't always grow with its rows: a month after 01-31 00:00 is 02-28 00:00,
# before the 02-28 23:00 of 01-30 23:00.
statement ok
set streaming_parallelism = 1;

statement ok
create table t (
    tm timestamp,
    foo int,
    bar int,
    watermark for tm as tm - interval '5 minutes'
) append only;

statement ok
set streaming_parallelism = 0;

statement ok
create materialized view mv_month as
select
    tm, foo, bar,
    count(*) over (partition by bar order by tm session with gap '1 month') as cnt
from t
emit on window close;

statement ok
insert into t values
  ('2025-01-30 23:00:00', 1, 1)
, ('2025-01-31 00:00:00', 2, 1);

# Watermark 02-28 01:00 closes the session.
statement ok
insert into t values ('2025-02-28 01:05:00', 0, 2);

query TIII
select * from mv_month where bar = 1 order by tm;
----
2025-01-30 23:00:00 1 1 2
2025-01-31 00:00:00 2 1 2

statement ok
drop materialized view mv_month;

statement ok
drop table t;

# A float frame end may round back to the current row, as 2^54 - 1 = 2^54 in `float8`, so the row
# stays in its own frame until the watermark passes it.
statement ok
set streaming_parallelism = 1;

statement ok
create table t (x float8, bar int, watermark for x as x - 1) append only;

statement ok
set streaming_parallelism = 0;

statement ok
create materialized view mv_float as
select
    x, bar,
    count(*) over (partition by bar order by x range between 1 preceding and 1 preceding) as cnt
from t
emit on window close;

statement ok
insert into t values (18014398509481984, 1);

# Watermark 2^54 + 16 passes the row.
statement ok
insert into t values (18014398509482000, 2);

query III
select x::bigint, bar, cnt from mv_float where bar = 1;
----
18014398509481984 1 1

statement ok
drop materialized view mv_float;

statement ok
drop table t;
