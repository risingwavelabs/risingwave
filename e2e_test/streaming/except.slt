CREATE TABLE inventory (
    sku INT PRIMARY KEY,
    stock INT
);

statement ok
INSERT INTO inventory VALUES (42, 314), (99, 2718);

statement ok
CREATE MATERIALIZED VIEW regional_stock AS
SELECT sku, stock FROM inventory
EXCEPT
SELECT sku, stock FROM inventory WHERE sku = 99;

query II rowsort
SELECT * FROM regional_stock;
----
