statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
CREATE TABLE source (
    class_id BIGINT PRIMARY KEY,
    description VARCHAR,
    free_usage BOOLEAN
);

statement ok
CREATE MATERIALIZED VIEW mv AS
WITH changes AS CHANGELOG FROM source KEY (class_id)
SELECT class_id, description, free_usage,
       changelog_op AS __op, CAST(_changelog_row_id AS BIGINT) AS __row_id
FROM changes;

statement ok
INSERT INTO source VALUES (42, 'Beginner', false);

statement ok
UPDATE source
SET description = 'Advanced', free_usage = true WHERE class_id = 42;

query ITI
SELECT class_id, description, free_usage::INT FROM source;
----
42 Advanced 1

query ITII
SELECT class_id, description, free_usage::INT, __op FROM mv ORDER BY __row_id;
----
42 Beginner 0 1
42 Beginner 0 4
42 Advanced 1 3

statement ok
DELETE FROM source WHERE class_id = 42;

query ITII
SELECT class_id, description, free_usage::INT, __op FROM mv ORDER BY __row_id;
----
42 Beginner 0 1
42 Beginner 0 4
42 Advanced 1 3
42 Advanced 1 2

statement ok
DROP MATERIALIZED VIEW mv;

statement ok
DROP TABLE source;
