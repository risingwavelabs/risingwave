# Verify impure expressions must be materialized on retract streams.

statement ok
set streaming_unsafe_allow_unmaterialized_impure_expr to default;

statement ok
set rw_implicit_flush to true;

statement ok
create table t (a int);

# StreamFilter: impure in filter predicate on retract stream should error.
# TODO: we should extract it and materialize it.
statement error using an impure expression \(RANDOM\) in WHERE or HAVING
create materialized view mv_impure_filter as
select * from t where random() > 0.5;

# Agg filter: impure in `FILTER (WHERE ...)` on retract stream should error.
# TODO: we should extract it and materialize it.
statement error using an impure expression \(RANDOM\) in AGGREGATE FILTER
create materialized view mv_impure_agg_filter as
select sum(a) filter (where random() > 0.5) from t;

# `IMMUTABLE` and `unsafe_skip_materializing_exprs` are supported only for scalar UDFs. Table,
# aggregate and SQL functions reject them instead of ignoring them.
skipif madsim
statement error `IMMUTABLE` is not supported for table functions
create function rejected_immutable_series(n int) returns table (x int) language javascript immutable as $$
export function* rejected_immutable_series(n) {
    yield { x: n };
}
$$;

skipif madsim
statement error `unsafe_skip_materializing_exprs` is not supported for table functions
create function rejected_skip_series(n int) returns table (x int) language javascript as $$
export function* rejected_skip_series(n) {
    yield { x: n };
}
$$ with (unsafe_skip_materializing_exprs = true);

skipif madsim
statement error `IMMUTABLE` is not supported for aggregate functions
create aggregate rejected_immutable_sum(value int) returns int language javascript immutable as $$
export function create_state() {
    return 0;
}
export function accumulate(state, value) {
    return state + value;
}
export function finish(state) {
    return state;
}
$$;

statement error `unsafe_skip_materializing_exprs` is not supported for SQL functions
create function rejected_sql_skip(v int) returns int language sql as 'select $1'
with (unsafe_skip_materializing_exprs = true);

# `STABLE` and `VOLATILE` have no effect and are still accepted for every kind of function.
skipif madsim
statement ok
create function rand_series(n int) returns table (x int) language javascript volatile as $$
export function* rand_series(n) {
    for (let i = 0; i < n; i++) {
        yield { x: Math.floor(Math.random() * 100) };
    }
}
$$;

# StreamProjectSet: user-defined table function on retract stream should error.
# TODO: we should extract it and materialize it.
skipif madsim
statement error using an impure expression \(user-defined table function `rand_series`\) in table function
create materialized view mv_impure_udtf_select_list as
select a, rand_series(a) from t;

skipif madsim
statement ok
drop function rand_series(int);

# Pure expressions may be re-evaluated on retract streams, so an `IMMUTABLE` UDF must enable network
# retries when its implementation supports them. Validation runs before RisingWave connects to the
# UDF server, so this test does not require a running server.
skipif madsim
statement error `always_retry_on_network_error` must be true for an `IMMUTABLE` UDF whose implementation supports it
create function rejected_external_without_retry(v int) returns int language java immutable
as 'identity'
using link 'http://localhost:8815';

skipif madsim
statement error `IMMUTABLE` must be specified when `unsafe_skip_materializing_exprs` is true
create function rejected_without_immutable(v int) returns int language javascript as $$
export function rejected_without_immutable(v) {
    return v;
}
$$ with (unsafe_skip_materializing_exprs = true);

# `always_retry_on_network_error` is accepted only when the UDF implementation supports retrying on
# network errors. Embedded UDFs and external UDTFs currently do not.
skipif madsim
statement error `always_retry_on_network_error` is not supported by this UDF implementation
create function rejected_embedded_retry(v int) returns int language javascript as $$
export function rejected_embedded_retry(v) {
    return v;
}
$$ with (always_retry_on_network_error = true);

skipif madsim
statement error `always_retry_on_network_error` is not supported by this UDF implementation
create function rejected_external_table_retry(n int) returns table (x int) language java
as 'series'
using link 'http://localhost:8815'
with (always_retry_on_network_error = true);

# Embedded scalar UDFs execute locally and do not use the external network-retry loop, so
# `IMMUTABLE` does not require `always_retry_on_network_error` for them.
skipif madsim
statement ok
create function identity_without_stored_result(v int) returns int language javascript immutable as $$
export function identity_without_stored_result(v) {
    return v;
}
$$ with (unsafe_skip_materializing_exprs = true);

skipif madsim
statement ok
create function identity_with_stored_result(v int) returns int language javascript immutable as $$
export function identity_with_stored_result(v) {
    return v;
}
$$;

skipif madsim
statement ok
create function identity_volatile(v int) returns int language javascript as $$
export function identity_volatile(v) {
    return v;
}
$$;

# The per-function purity and execution policy must be visible to users through the function
# catalog.
skipif madsim
query TBB
select name, is_immutable, unsafe_skip_materializing_exprs
from rw_catalog.rw_functions
where name in ('identity_volatile', 'identity_with_stored_result', 'identity_without_stored_result')
order by name;
----
identity_volatile f f
identity_with_stored_result t f
identity_without_stored_result t t

# Purity follows `IMMUTABLE`: a filter on a retract stream accepts an `IMMUTABLE` UDF even when it
# keeps materialization, and rejects a UDF that is not `IMMUTABLE`.
skipif madsim
statement error using an impure expression \(user-defined function `identity_volatile`\) in WHERE or HAVING
create materialized view mv_volatile_filter as
select * from t where identity_volatile(a) > 0;

skipif madsim
statement ok
create materialized view mv_immutable_filter as
select * from t where identity_with_stored_result(a) > 0;

skipif madsim
statement ok
drop materialized view mv_immutable_filter;

# A generated-column expression is persisted as an ExprNode in the target table catalog and then
# reconstructed while planning the sink. The sink reads its source snapshot as a RETRACT stream,
# so successful planning proves that the reconstructed UDF remains pure.
skipif madsim
statement ok
create table generated_udf_source (id int primary key, v int);

skipif madsim
statement ok
create table generated_udf_target (
    id int primary key,
    v int,
    generated_v int as identity_without_stored_result(v)
);

skipif madsim
statement ok
create sink generated_udf_sink into generated_udf_target as
select id, v from generated_udf_source;

skipif madsim
query TT
with scan_node as (
    select jsonb_path_query_first(
        f.node,
        '$.**.**.** ? (exists(@.streamScan))'
    ) as node
    from rw_catalog.rw_fragment_infos f
    join rw_catalog.rw_relations r on r.id = f.table_id
    where r.name = 'generated_udf_sink'
)
select
    coalesce(node->>'streamKind', 'STREAM_KIND_RETRACT'),
    node->'streamScan'->>'streamScanType'
from scan_node;
----
STREAM_KIND_RETRACT STREAM_SCAN_TYPE_ARRANGEMENT_BACKFILL

skipif madsim
statement ok
insert into generated_udf_source values (1, 10);

skipif madsim
query III
select * from generated_udf_target;
----
1 10 10

skipif madsim
statement ok
drop sink generated_udf_sink;

skipif madsim
statement ok
drop table generated_udf_target;

skipif madsim
statement ok
drop table generated_udf_source;

skipif madsim
statement ok
create materialized view mv_without_stored_result as
select identity_without_stored_result(a) as a from t;

# `t` is not append-only, and an MV reads its snapshot. Therefore the decisive branch in
# `StreamTableScan::new_with_scan_range` selects RETRACT.
# RETRACT is the protobuf default and is omitted from its JSON, so map an absent value back to it.
skipif madsim
query TT
with scan_node as (
    select jsonb_path_query_first(
        f.node,
        '$.**.**.** ? (exists(@.streamScan))'
    ) as node
    from rw_catalog.rw_fragment_infos f
    join rw_catalog.rw_relations r on r.id = f.table_id
    where r.name = 'mv_without_stored_result'
)
select
    coalesce(node->>'streamKind', 'STREAM_KIND_RETRACT'),
    node->'streamScan'->>'streamScanType'
from scan_node;
----
STREAM_KIND_RETRACT STREAM_SCAN_TYPE_SNAPSHOT_BACKFILL

skipif madsim
statement ok
create materialized view mv_with_stored_result as
select identity_with_stored_result(a) as a from t;

skipif madsim
statement ok
create materialized view mv_volatile as
select identity_volatile(a) as a from t;

# Materialization follows `unsafe_skip_materializing_exprs`, not `IMMUTABLE`: only the opted-out UDF
# skips the MaterializedExprs state table.
skipif madsim
query TI
select mv.name, count(it.id)
from rw_catalog.rw_materialized_views mv
left join rw_catalog.rw_internal_tables it
on it.job_id = mv.id and it.name like '%materializedexprs%'
where mv.name in ('mv_volatile', 'mv_with_stored_result', 'mv_without_stored_result')
group by mv.name
order by mv.name;
----
mv_volatile 1
mv_with_stored_result 1
mv_without_stored_result 0

# Exercise the opted-out UDF on an actual RETRACT stream. The update emits a complete old row and
# a new row; the delete then retracts the second result.
skipif madsim
statement ok
insert into t values (10), (20);

skipif madsim
statement ok
update t set a = 11 where a = 10;

skipif madsim
statement ok
delete from t where a = 20;

skipif madsim
query I
select * from mv_without_stored_result;
----
11

skipif madsim
statement ok
create materialized view mv_nested_random as
select identity_without_stored_result(random()::int) as a from t;

# The impure descendant makes the complete top-level expression impure, but it still requires only
# one MaterializedExprs state table.
skipif madsim
query I
select count(*)
from rw_catalog.rw_internal_tables
where job_id = (
    select id from rw_catalog.rw_materialized_views where name = 'mv_nested_random'
)
and name like '%materializedexprs%';
----
1

# A sink without a snapshot reads its table input as an UPSERT stream. Insert a row before creating
# the sinks to prove that this snapshot-free path skips preexisting data.
skipif madsim
statement ok
create table upsert_udf_input (id int primary key, v int);

skipif madsim
statement ok
insert into upsert_udf_input values (0, 0);

skipif madsim
statement ok
create table upsert_udf_marked_output (v int, id int primary key);

skipif madsim
statement ok
create table upsert_udf_unmarked_output (v int, id int primary key);

skipif madsim
statement ok
create sink upsert_udf_marked_sink into upsert_udf_marked_output as
select identity_without_stored_result(v) as v, id
from upsert_udf_input
with (snapshot = 'false');

# `upsert_udf_input` is not append-only, and `snapshot = 'false'` selects a snapshot-free scan.
# Therefore `backfill_type.without_snapshot()` selects UPSERT in `StreamTableScan`.
skipif madsim
query TT
with scan_node as (
    select jsonb_path_query_first(
        f.node,
        '$.**.**.** ? (exists(@.streamScan))'
    ) as node
    from rw_catalog.rw_fragment_infos f
    join rw_catalog.rw_relations r on r.id = f.table_id
    where r.name = 'upsert_udf_marked_sink'
)
select
    coalesce(node->>'streamKind', 'STREAM_KIND_RETRACT'),
    node->'streamScan'->>'streamScanType'
from scan_node
where node is not null;
----
STREAM_KIND_UPSERT STREAM_SCAN_TYPE_UPSTREAM_ONLY

# An UPSERT project's stream key consists only of direct input references, so no matter the UDF is
# pure or impure it does not need result materialization.
skipif madsim
query I
select count(*)
from rw_catalog.rw_internal_tables
where job_id = (
    select id from rw_catalog.rw_sinks where name = 'upsert_udf_marked_sink'
)
and name like '%materializedexprs%';
----
0

skipif madsim
statement ok
create sink upsert_udf_unmarked_sink into upsert_udf_unmarked_output as
select identity_with_stored_result(v) as v, id
from upsert_udf_input
with (snapshot = 'false');

skipif madsim
query I
select count(*)
from rw_catalog.rw_internal_tables
where job_id = (
    select id from rw_catalog.rw_sinks where name = 'upsert_udf_unmarked_sink'
)
and name like '%materializedexprs%';
----
0

# Both snapshot-free sinks skip the preexisting row.
skipif madsim
query II
select * from upsert_udf_marked_output order by id;
----

skipif madsim
query II
select * from upsert_udf_unmarked_output order by id;
----

# Exercise both project variants on actual UPSERT records. The update emits a live upsert record;
# the delete then removes the second key.
skipif madsim
statement ok
insert into upsert_udf_input values (1, 10), (2, 20);

skipif madsim
statement ok
update upsert_udf_input set v = 11 where id = 1;

skipif madsim
statement ok
delete from upsert_udf_input where id = 2;

skipif madsim
query II
select * from upsert_udf_marked_output order by id;
----
11 1

skipif madsim
query II
select * from upsert_udf_unmarked_output order by id;
----
11 1

skipif madsim
statement ok
