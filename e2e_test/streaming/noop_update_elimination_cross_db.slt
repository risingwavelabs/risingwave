SET RW_IMPLICIT_FLUSH TO true;

statement ok
create database noop_cross_db_src;

statement ok
create database noop_cross_db_mv;

statement ok
set database to noop_cross_db_src;

statement ok
create table owner (id int primary key, account_id int, display_name varchar);

statement ok
create table content (id int primary key, owner_id int);

statement ok
insert into owner values (1, 10, 'a'), (2, 20, 'b');

statement ok
insert into content values (1, 1), (2, 1), (3, 1), (4, 2);

statement ok
create subscription owner_sub from owner with (retention = '1D');

statement ok
create subscription content_sub from content with (retention = '1D');

statement ok
set database to noop_cross_db_mv;

statement ok
create materialized view content_context as
select content.id, owner.account_id
from noop_cross_db_src.public.content
left join noop_cross_db_src.public.owner on owner.id = content.owner_id;

statement ok
create materialized view content_context_log as
with sub as changelog from content_context
select * from sub;

query I
select count(*) from content_context_log;
----
4

statement ok
set database to noop_cross_db_src;

statement ok
update owner set display_name = 'renamed' where id = 1;

statement ok
update owner set account_id = 21 where id = 2;

statement ok
set database to noop_cross_db_mv;

query II retry 10 backoff 1s
select id, account_id from content_context where id = 4;
----
4 21

query I
select count(*) from content_context_log where id <> 4;
----
3

statement ok
set database to noop_cross_db_src;

statement ok
update owner set account_id = 11 where id = 1;

statement ok
set database to noop_cross_db_mv;

query II rowsort retry 10 backoff 1s
select id, account_id from content_context;
----
1 11
2 11
3 11
4 21

