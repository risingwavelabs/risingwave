statement ok
create table items_sold (brand varchar, size varchar, sales int);

statement ok
insert into items_sold values ('Foo', 'L', 10),('Foo', 'M', 20),('Bar', 'M', 15),('Bar', 'L', '5');

statement ok
create materialized view v as SELECT brand, size, sum(sales), grouping(brand) g1, grouping(size) g2, grouping(brand,size) g3, count(distinct sales) FROM items_sold GROUP BY GROUPING SETS ((brand), (size), ());

query TTIIIII rowsort
select * from v;
----
Bar NULL 20 0 1 1 2
Foo NULL 30 0 1 1 2
NULL L 15 1 0 2 2
NULL M 35 1 0 2 2
NULL NULL 50 1 1 3 4

statement ok
create materialized view v_flag_only as SELECT count(*) FROM items_sold GROUP BY GROUPING SETS ((), ());

query I rowsort
select * from v_flag_only;
----
4
4

statement ok
create materialized view v_brand as
SELECT brand, sum(sales) AS s FROM items_sold GROUP BY GROUPING SETS ((brand), ());

query TI rowsort
select * from v_brand;
----
Bar 20
Foo 30
NULL 50

statement ok
drop materialized view v_brand;

statement ok
drop materialized view v_flag_only;

statement ok
drop materialized view v;

statement ok
drop table items_sold;

statement ok
create table empty_grouping_input (v int);

statement ok
create materialized view empty_single as
SELECT count(*) AS c, sum(v) AS s FROM empty_grouping_input WHERE v < 0 GROUP BY GROUPING SETS (());

statement ok
create materialized view empty_duplicate as
SELECT count(*) AS c, count(v) AS cv, sum(v) AS s, count(distinct v) AS d,
       count(*) FILTER (WHERE v < -2) AS f
FROM empty_grouping_input WHERE v < 0 GROUP BY GROUPING SETS ((), ());

statement ok
create materialized view empty_mixed as
SELECT v, grouping(v, v) AS g, count(*) AS c, sum(v) AS s
FROM empty_grouping_input GROUP BY GROUPING SETS ((), (v), ());

statement ok
create materialized view empty_rollup as
SELECT v, grouping(v) AS g, count(*) AS c FROM empty_grouping_input GROUP BY ROLLUP(v);

statement ok
create materialized view empty_cube as
SELECT v, grouping(v) AS g, count(*) AS c FROM empty_grouping_input GROUP BY CUBE(v);

statement ok
create materialized view empty_having as
SELECT count(*) AS c FROM empty_grouping_input WHERE v < 0 GROUP BY GROUPING SETS ((), ()) HAVING count(*) = 0;

statement ok
create materialized view empty_no_agg as
SELECT 7 AS c FROM empty_grouping_input GROUP BY GROUPING SETS ((), ());

statement ok
