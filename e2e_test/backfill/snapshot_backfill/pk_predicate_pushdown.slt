# Test predicate pushdown on PK prefix for snapshot backfill.
# Verifies that range filters and equality predicates on PK columns
# are correctly pushed down and produce the same results as batch queries.

statement ok
set streaming_use_snapshot_backfill = true;

# Create a table with composite primary key (a, b)
statement ok
CREATE TABLE t_pk_pred(a INT, b INT, c INT, PRIMARY KEY(a, b));

# Insert test data covering various ranges
statement ok
INSERT INTO t_pk_pred SELECT
  i / 10 AS a,
  i % 10 AS b,
  i * 10 AS c
FROM generate_series(0, 99) AS s(i);

statement ok
flush;

# ---- Test 1: Prefix equality pushdown (a = 3) ----

statement ok
CREATE MATERIALIZED VIEW mv_eq AS SELECT * FROM t_pk_pred WHERE a = 3;

query III rowsort
SELECT * FROM mv_eq;
----
3 0 300
3 1 310
3 2 320
3 3 330
3 4 340
3 5 350
3 6 360
3 7 370
3 8 380
3 9 390

# Verify MV matches batch query
query T
SELECT * FROM mv_eq EXCEPT SELECT * FROM t_pk_pred WHERE a = 3;
----

query T
SELECT * FROM t_pk_pred WHERE a = 3 EXCEPT SELECT * FROM mv_eq;
----

# ---- Test 2: Range filter on first PK column (a >= 7 AND a <= 9) ----

statement ok
CREATE MATERIALIZED VIEW mv_range AS SELECT * FROM t_pk_pred WHERE a >= 7 AND a <= 9;

query T
SELECT * FROM mv_range EXCEPT SELECT * FROM t_pk_pred WHERE a >= 7 AND a <= 9;
----

query T
SELECT * FROM t_pk_pred WHERE a >= 7 AND a <= 9 EXCEPT SELECT * FROM mv_range;
----

query I
SELECT count(*) FROM mv_range;
----
30

# ---- Test 3: Prefix equality + range on second PK column (a = 5 AND b >= 3 AND b <= 7) ----

statement ok
CREATE MATERIALIZED VIEW mv_eq_range AS SELECT * FROM t_pk_pred WHERE a = 5 AND b >= 3 AND b <= 7;

query III rowsort
SELECT * FROM mv_eq_range;
----
5 3 530
5 4 540
5 5 550
5 6 560
5 7 570

query T
SELECT * FROM mv_eq_range EXCEPT SELECT * FROM t_pk_pred WHERE a = 5 AND b >= 3 AND b <= 7;
----

query T
SELECT * FROM t_pk_pred WHERE a = 5 AND b >= 3 AND b <= 7 EXCEPT SELECT * FROM mv_eq_range;
----

# ---- Test 4: Prefix equality + one-sided range (a = 2 AND b > 5) ----

statement ok
CREATE MATERIALIZED VIEW mv_eq_onesided AS SELECT * FROM t_pk_pred WHERE a = 2 AND b > 5;

query III rowsort
SELECT * FROM mv_eq_onesided;
----
2 6 260
2 7 270
2 8 280
2 9 290

query T
SELECT * FROM mv_eq_onesided EXCEPT SELECT * FROM t_pk_pred WHERE a = 2 AND b > 5;
----

query T
SELECT * FROM t_pk_pred WHERE a = 2 AND b > 5 EXCEPT SELECT * FROM mv_eq_onesided;
----

# ---- Test 5: Verify correctness after new inserts ----
# After backfill completes, new data matching the predicate should appear in MVs

statement ok
INSERT INTO t_pk_pred VALUES (3, 10, 999), (5, 5, 888), (2, 8, 777);

statement ok
flush;

# New row (3, 10, 999) should appear in mv_eq (a = 3 matches, but technically
# the StreamFilter above will handle new data, not the backfill pushdown).
# This just confirms end-to-end correctness.
query T
SELECT * FROM mv_eq EXCEPT SELECT * FROM t_pk_pred WHERE a = 3;
----

query T
SELECT * FROM t_pk_pred WHERE a = 3 EXCEPT SELECT * FROM mv_eq;
----

# (5, 5, 888) replaces the old (5, 5, 550) since (5, 5) is the PK
query T
SELECT * FROM mv_eq_range EXCEPT SELECT * FROM t_pk_pred WHERE a = 5 AND b >= 3 AND b <= 7;
----

query T
SELECT * FROM t_pk_pred WHERE a = 5 AND b >= 3 AND b <= 7 EXCEPT SELECT * FROM mv_eq_range;
----

# (2, 8, 777) replaces old (2, 8, 280)
query T
SELECT * FROM mv_eq_onesided EXCEPT SELECT * FROM t_pk_pred WHERE a = 2 AND b > 5;
----

query T
SELECT * FROM t_pk_pred WHERE a = 2 AND b > 5 EXCEPT SELECT * FROM mv_eq_onesided;
----

statement ok
DROP TABLE t_pk_pred cascade;

# ============================================================
# DESC index PK order tests
# Snapshot backfill can scan an index instead of the base table.
# When the index has DESC columns, range bounds must be swapped.
# ============================================================

statement ok
CREATE TABLE t_idx(a INT, b INT, c INT, PRIMARY KEY(a));

statement ok
CREATE INDEX idx_bc_desc ON t_idx(b, c DESC);

statement ok
INSERT INTO t_idx VALUES
  (1, 1, 1),
  (2, 1, 3),
  (3, 1, 5),
  (4, 1, 7),
  (5, 1, 9),
  (6, 2, 2),
  (7, 2, 4),
  (8, 2, 6),
  (9, 2, 8),
  (10, 2, 10);

statement ok
flush;

# ---- Test 6: Select from DESC index with prefix eq + range on DESC column ----
# Index idx_bc_desc has PK (b ASC, c DESC, a ASC).
# Predicate b = 1 AND c > 5 should push down as eq_conds=[1], range=(Excluded(5), Unbounded).
# With DESC on c, storage needs to swap bounds.

statement ok
CREATE MATERIALIZED VIEW mv_idx_desc AS SELECT * FROM idx_bc_desc WHERE b = 1 AND c > 5;

query III rowsort
SELECT * FROM mv_idx_desc;
----
1 7 4
1 9 5

query T
SELECT * FROM mv_idx_desc EXCEPT SELECT b, c, a FROM t_idx WHERE b = 1 AND c > 5;
----

query T
SELECT b, c, a FROM t_idx WHERE b = 1 AND c > 5 EXCEPT SELECT * FROM mv_idx_desc;
----

# ---- Test 7: DESC index with two-sided range ----
# b = 2 AND c >= 4 AND c <= 8

statement ok
CREATE MATERIALIZED VIEW mv_idx_desc_range AS SELECT * FROM idx_bc_desc WHERE b = 2 AND c >= 4 AND c <= 8;

query III rowsort
SELECT * FROM mv_idx_desc_range;
----
2 4 7
2 6 8
2 8 9

query T
SELECT * FROM mv_idx_desc_range EXCEPT SELECT b, c, a FROM t_idx WHERE b = 2 AND c >= 4 AND c <= 8;
----

query T
SELECT b, c, a FROM t_idx WHERE b = 2 AND c >= 4 AND c <= 8 EXCEPT SELECT * FROM mv_idx_desc_range;
----

# ---- Test 8: DESC index, verify post-backfill inserts ----

statement ok
INSERT INTO t_idx VALUES (11, 1, 8), (12, 2, 5);

statement ok
flush;

query T
SELECT * FROM mv_idx_desc EXCEPT SELECT b, c, a FROM t_idx WHERE b = 1 AND c > 5;
----

query T
SELECT b, c, a FROM t_idx WHERE b = 1 AND c > 5 EXCEPT SELECT * FROM mv_idx_desc;
----

query T
SELECT * FROM mv_idx_desc_range EXCEPT SELECT b, c, a FROM t_idx WHERE b = 2 AND c >= 4 AND c <= 8;
----

query T
SELECT b, c, a FROM t_idx WHERE b = 2 AND c >= 4 AND c <= 8 EXCEPT SELECT * FROM mv_idx_desc_range;
----

statement ok
DROP TABLE t_idx cascade;

# ============================================================
# IN predicate tests (UNION of StreamTableScans)
# ============================================================

statement ok
CREATE TABLE t_in(a INT, b INT, c INT, PRIMARY KEY(a, b));

statement ok
INSERT INTO t_in SELECT
  i / 10 AS a,
  i % 10 AS b,
  i * 10 AS c
FROM generate_series(0, 99) AS s(i);

statement ok
flush;

# ---- Test 9: IN predicate on first PK column ----

statement ok
CREATE MATERIALIZED VIEW mv_in AS SELECT * FROM t_in WHERE a IN (2, 5, 8);

query T
SELECT * FROM mv_in EXCEPT SELECT * FROM t_in WHERE a IN (2, 5, 8);
----

query T
SELECT * FROM t_in WHERE a IN (2, 5, 8) EXCEPT SELECT * FROM mv_in;
----

query I
SELECT count(*) FROM mv_in;
----
30

# ---- Test 10: IN predicate with covering index ----

statement ok
CREATE INDEX idx_b_in ON t_in(b) include(a, c);

statement ok
CREATE MATERIALIZED VIEW mv_in_idx AS SELECT * FROM idx_b_in WHERE b IN (1, 3, 7);

query T
SELECT * FROM mv_in_idx EXCEPT SELECT b, a, c FROM t_in WHERE b IN (1, 3, 7);
----

query T
SELECT b, a, c FROM t_in WHERE b IN (1, 3, 7) EXCEPT SELECT * FROM mv_in_idx;
----

query I
SELECT count(*) FROM mv_in_idx;
----
30

# ---- Test 11: Verify post-backfill inserts with IN ----

statement ok
INSERT INTO t_in VALUES (2, 10, 999), (5, 10, 888);

statement ok
flush;

query T
SELECT * FROM mv_in EXCEPT SELECT * FROM t_in WHERE a IN (2, 5, 8);
----

query T
SELECT * FROM t_in WHERE a IN (2, 5, 8) EXCEPT SELECT * FROM mv_in;
----

statement ok
DROP TABLE t_in cascade;

# ---- Test 12: IS NULL branches keep the NULL rows ----

statement ok
CREATE TABLE t_is_null(a INT, b INT, c INT, d INT, PRIMARY KEY(a, b, c));

statement ok
INSERT INTO t_is_null VALUES (NULL, 1, 1, 1), (NULL, 2, 5, -1), (NULL, 3, 3, -1), (1, 1, 1, 0), (2, 1, 1, 0);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_is_null AS SELECT * FROM t_is_null WHERE a IS NULL OR a = 1;

# The third arm is contained in the first one, so only eq ranges are left.
statement ok
CREATE MATERIALIZED VIEW mv_is_null_merged AS SELECT * FROM t_is_null WHERE a IS NULL OR a = 1 OR (a IS NULL AND b = 2 AND c > 3);

query IIII rowsort
SELECT * FROM mv_is_null;
----
1 1 1 0
NULL 1 1 1
NULL 2 5 -1
NULL 3 3 -1

query IIII rowsort
SELECT * FROM mv_is_null_merged;
----
1 1 1 0
NULL 1 1 1
NULL 2 5 -1
NULL 3 3 -1

statement ok
INSERT INTO t_is_null VALUES (NULL, 4, 4, 4), (1, 2, 2, 2), (3, 1, 1, 1);

statement ok
DELETE FROM t_is_null WHERE a IS NULL AND b = 1;

statement ok
flush;

query IIII rowsort
SELECT * FROM mv_is_null;
----
1 1 1 0
1 2 2 2
NULL 2 5 -1
NULL 3 3 -1
NULL 4 4 4

query IIII rowsort
SELECT * FROM mv_is_null_merged;
----
1 1 1 0
1 2 2 2
NULL 2 5 -1
NULL 3 3 -1
NULL 4 4 4

statement ok
DROP TABLE t_is_null cascade;

# ---- Test 13: Nothing comes after the largest key of a descending pk ----

statement ok
CREATE TABLE t_desc(a INT, b INT, c INT, PRIMARY KEY(a, b));

statement ok
INSERT INTO t_desc VALUES (-2147483648, -2147483648, 1), (-2147483648, 0, 2), (0, 0, 3);

statement ok
CREATE TABLE t_desc_str(a VARCHAR PRIMARY KEY);

statement ok
INSERT INTO t_desc_str VALUES (''), ('a');

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_desc AS SELECT a, b, c FROM t_desc ORDER BY a DESC, b DESC;

statement ok
CREATE MATERIALIZED VIEW mv_desc_str AS SELECT a FROM t_desc_str ORDER BY a DESC;

query III
SELECT * FROM mv_desc WHERE a < -2147483648;
----

# OR arms merge into the same bound.
query III
SELECT * FROM mv_desc WHERE a < -2147483648 OR a < -2147483648::BIGINT;
----

query III
SELECT * FROM mv_desc WHERE a = -2147483648 AND b < -2147483648;
----

query T
SELECT * FROM mv_desc_str WHERE a < '';
----

statement ok
CREATE MATERIALIZED VIEW mv_desc_min AS SELECT * FROM mv_desc WHERE a < -2147483648;

statement ok
CREATE MATERIALIZED VIEW mv_desc_min_or AS SELECT * FROM mv_desc WHERE a < -2147483648 OR a < -2147483648::BIGINT;

statement ok
CREATE MATERIALIZED VIEW mv_desc_min_prefix AS SELECT * FROM mv_desc WHERE a = -2147483648 AND b < -2147483648;

query I
SELECT (SELECT count(*) FROM mv_desc_min) + (SELECT count(*) FROM mv_desc_min_or) + (SELECT count(*) FROM mv_desc_min_prefix);
----
0

query III rowsort
SELECT * FROM mv_desc WHERE a <= -2147483648;
----
-2147483648 -2147483648 1
-2147483648 0 2

statement ok
DROP TABLE t_desc cascade;

statement ok
DROP TABLE t_desc_str cascade;

# ---- Test 14: A row comparison, with NULLs and later changes ----

statement ok
CREATE TABLE t_row(a INT, b INT, c INT, PRIMARY KEY(a, b));

statement ok
INSERT INTO t_row VALUES (1, 3, 1), (1, 5, 2), (1, 6, 3), (2, 0, 4), (NULL, 1, 5), (1, NULL, 6), (2, NULL, 7), (NULL, NULL, 8);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_row AS SELECT a, b FROM t_row WHERE (a, b) > (1, 5);

statement ok
CREATE MATERIALIZED VIEW mv_row_le AS SELECT a, b FROM t_row WHERE (a, b) <= (1, 5);

statement ok
CREATE MATERIALIZED VIEW mv_row_null AS SELECT a, b FROM t_row WHERE (a, b) > (NULL::INT, 1);

query II rowsort
SELECT * FROM mv_row;
----
1 6
2 0
2 NULL

query II rowsort
SELECT * FROM mv_row_le;
----
1 3
1 5

query II rowsort
SELECT * FROM mv_row_null;
----

statement ok
INSERT INTO t_row VALUES (1, 7, 9), (1, 4, 10), (NULL, 9, 11), (3, NULL, 12);

statement ok
DELETE FROM t_row WHERE a = 2;

statement ok
UPDATE t_row SET c = 13 WHERE a = 1 AND b = 6;

statement ok
flush;

query II rowsort
SELECT * FROM mv_row;
----
1 6
1 7
3 NULL

query II rowsort
SELECT * FROM mv_row_le;
----
1 3
1 4
1 5

query II rowsort
SELECT * FROM mv_row_null;
----

statement ok
DROP TABLE t_row cascade;

# ---- Test 15: Later columns narrow each value of an IN list ----

statement ok
CREATE TABLE t_in_range(a INT, b INT, c INT, PRIMARY KEY(a, b));

statement ok
INSERT INTO t_in_range VALUES (1, 5, 1), (1, 6, 2), (2, 7, 3), (2, 1, 4), (3, 9, 5), (1, NULL, 6), (NULL, 8, 7);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_in_range AS SELECT a, b, c FROM t_in_range WHERE a IN (1, 2) AND b > 5;

query III rowsort
SELECT * FROM mv_in_range;
----
1 6 2
2 7 3

statement ok
INSERT INTO t_in_range VALUES (1, 8, 8), (2, 2, 9), (3, 10, 10);

statement ok
DELETE FROM t_in_range WHERE a = 2 AND b = 7;

statement ok
UPDATE t_in_range SET c = 11 WHERE a = 1 AND b = 6;

statement ok
flush;

query III rowsort
SELECT * FROM mv_in_range;
----
1 6 11
1 8 8

statement ok
DROP TABLE t_in_range cascade;

# ---- Test 16: Disjoint ranges of one column ----

statement ok
CREATE TABLE t_ranges(a INT PRIMARY KEY, b INT);

statement ok
INSERT INTO t_ranges VALUES (0, 0), (1, 1), (5, 5), (6, 6), (NULL, 9);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_ranges AS SELECT a, b FROM t_ranges WHERE a = 1 OR a > 5;

statement ok
CREATE MATERIALIZED VIEW mv_ranges_null AS SELECT a, b FROM t_ranges WHERE a = 1 OR a > 5 OR a IS NULL;

query II rowsort
SELECT * FROM mv_ranges;
----
1 1
6 6

query II rowsort
SELECT * FROM mv_ranges_null;
----
1 1
6 6
NULL 9

statement ok
INSERT INTO t_ranges VALUES (2, 2), (7, 7);

statement ok
DELETE FROM t_ranges WHERE a = 1;

statement ok
UPDATE t_ranges SET b = 10 WHERE a IS NULL;

statement ok
flush;

query II rowsort
SELECT * FROM mv_ranges;
----
6 6
7 7

query II rowsort
SELECT * FROM mv_ranges_null;
----
6 6
7 7
NULL 10

statement ok
DROP TABLE t_ranges cascade;

# ---- Test 17: A constant that needs the session timezone ----

statement ok
CREATE TABLE t_tz(a TIMESTAMPTZ PRIMARY KEY, b INT);

statement ok
INSERT INTO t_tz VALUES ('2024-01-01 00:00:00+00', 1), ('2024-01-02 00:00:00+00', 2);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_tz AS SELECT b FROM t_tz WHERE a > '2024-01-01 12:00:00+00';

query I rowsort
SELECT * FROM mv_tz;
----
2

statement ok
CREATE MATERIALIZED VIEW mv_tz_session AS SELECT b FROM t_tz WHERE a > '2024-01-01 12:00:00';

query I rowsort
SELECT * FROM mv_tz_session;
----
2

statement ok
DROP TABLE t_tz cascade;

# ---- Test 18: Each value of an IN list is a branch, whatever the rest of the condition is ----

statement ok
CREATE TABLE t_in_rest(a INT, b INT, c INT, PRIMARY KEY(a, b, c));

statement ok
INSERT INTO t_in_rest VALUES (1, 1, 5), (1, 1, 6), (1, 2, 0), (1, NULL, 1), (2, 1, 7), (2, 0, 9), (3, 2, 2), (NULL, 2, 2);

statement ok
flush;

statement ok
CREATE MATERIALIZED VIEW mv_in_row AS SELECT a, b, c FROM t_in_rest WHERE a IN (1, 2) AND (b, c) > (1, 5);

statement ok
CREATE MATERIALIZED VIEW mv_in_or AS SELECT a, b, c FROM t_in_rest WHERE a IN (1, 2) AND (b > 1 OR b IS NULL);

query III rowsort
SELECT * FROM mv_in_row;
----
1 1 6
1 2 0
2 1 7

query III rowsort
SELECT * FROM mv_in_or;
----
1 2 0
1 NULL 1

statement ok
INSERT INTO t_in_rest VALUES (2, 3, 3), (2, NULL, 4), (1, 1, 7), (3, 5, 5);

statement ok
DELETE FROM t_in_rest WHERE a = 1 AND b = 2;

statement ok
flush;

query III rowsort
SELECT * FROM mv_in_row;
----
1 1 6
1 1 7
2 1 7
2 3 3

query III rowsort
SELECT * FROM mv_in_or;
----
1 NULL 1
2 3 3
2 NULL 4

statement ok
DROP TABLE t_in_rest cascade;
