control substitution on

# Moving Kafka sources, tables and sinks to another cluster with
# `ALTER ... CONNECTOR WITH (properties.bootstrap.server = ...)`.
#
# The two SASL clusters are unrelated, so a source keeps its partition offsets from cluster 1 when
# it is pointed to cluster 2: messages at the same offsets on cluster 2 are skipped. This is the
# documented behavior for offset-incompatible clusters, and `ALTER` emits a notice about it.

system ok
rpk topic delete test_alter_bs -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw || true

system ok
rpk topic create test_alter_bs -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
cat << EOF | rpk topic produce test_alter_bs -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw
{"x": 1}
{"x": 2}
{"x": 3}
EOF

system ok
rpk topic delete test_alter_bs -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw || true

system ok retry 20 backoff 1s
rpk topic create test_alter_bs -p 2 -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw

system ok
cat << EOF | rpk topic produce test_alter_bs -p 0 -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw
{"x": 4}
{"x": 5}
{"x": 6}
EOF

# ==== shared source and table with connector ====

statement ok
create source s_alter_bs (x int) with (
    connector = 'kafka',
    properties.bootstrap.server = 'message_queue_sasl_1:19092',
    properties.security.protocol = 'SASL_PLAINTEXT',
    properties.sasl.mechanism = 'PLAIN',
    properties.sasl.username = 'dev',
    properties.sasl.password = 'rw',
    topic = 'test_alter_bs'
) format plain encode json;

statement ok
create materialized view mv_alter_bs as select * from s_alter_bs;

statement ok
create table t_alter_bs (x int) with (
    connector = 'kafka',
    properties.bootstrap.server = 'message_queue_sasl_1:19092',
    properties.security.protocol = 'SASL_PLAINTEXT',
    properties.sasl.mechanism = 'PLAIN',
    properties.sasl.username = 'dev',
    properties.sasl.password = 'rw',
    topic = 'test_alter_bs'
) format plain encode json;

query I retry 15 backoff 2s
select * from mv_alter_bs order by x;
----
1
2
3

query I retry 15 backoff 2s
select * from t_alter_bs order by x;
----
1
2
3

# The new brokers are validated with the merged properties before anything is changed: the
# credentials of cluster 1 do not work on cluster 2.
statement error failed to fetch metadata from kafka \(message_queue_sasl_2:19093\)
alter source s_alter_bs connector with (properties.bootstrap.server = 'message_queue_sasl_2:19093');

query I
select count(*) from rw_sources
where name = 's_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''message_queue_sasl_1:19092''%'
  and definition ilike '%properties.sasl.username = ''dev''%';
----
1

statement ok
alter source s_alter_bs connector with (
    properties.bootstrap.server = 'message_queue_sasl_2:19093',
    properties.sasl.username = 'dev1'
);

statement ok
alter table t_alter_bs connector with (
    properties.bootstrap.server = 'message_queue_sasl_2:19093',
    properties.sasl.username = 'dev1'
);

query I
select count(*) from rw_sources
where name in ('s_alter_bs', 't_alter_bs')
  and definition ilike '%properties.bootstrap.server = ''message_queue_sasl_2:19093''%'
  and definition ilike '%properties.sasl.username = ''dev1''%';
----
2

# New data on the new cluster is ingested, including the partition that only exists there.
system ok
cat << EOF | rpk topic produce test_alter_bs -p 0 -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw
{"x": 7}
{"x": 8}
{"x": 9}
EOF

system ok
cat << EOF | rpk topic produce test_alter_bs -p 1 -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw
{"x": 10}
{"x": 11}
{"x": 12}
EOF

# Data on the old cluster is not ingested anymore.
system ok
cat << EOF | rpk topic produce test_alter_bs -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw
{"x": 13}
{"x": 14}
{"x": 15}
EOF

sleep 5s

query I retry 5 backoff 3s
select * from mv_alter_bs order by x;
----
1
2
3
7
8
9
10
11
12

query I retry 5 backoff 3s
select * from t_alter_bs order by x;
----
1
2
3
7
8
9
10
11
12

# ==== a cluster with fewer partitions is rejected ====

system ok
rpk topic delete test_alter_bs_fewer -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw || true

system ok
rpk topic create test_alter_bs_fewer -p 2 -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
cat << EOF | rpk topic produce test_alter_bs_fewer -p 0 -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw
{"x": 1}
EOF

system ok
cat << EOF | rpk topic produce test_alter_bs_fewer -p 1 -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw
{"x": 2}
EOF

system ok
rpk topic delete test_alter_bs_fewer -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw || true

system ok
rpk topic create test_alter_bs_fewer -p 1 -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw

statement ok
create table t_alter_bs_fewer (x int) with (
    connector = 'kafka',
    properties.bootstrap.server = 'message_queue_sasl_1:19092',
    properties.security.protocol = 'SASL_PLAINTEXT',
    properties.sasl.mechanism = 'PLAIN',
    properties.sasl.username = 'dev',
    properties.sasl.password = 'rw',
    topic = 'test_alter_bs_fewer'
) format plain encode json;

# Both partitions are assigned once their data has been ingested.
query I retry 15 backoff 2s
select * from t_alter_bs_fewer order by x;
----
1
2

statement error assigned to source .* but are not found with the new properties
alter table t_alter_bs_fewer connector with (
    properties.bootstrap.server = 'message_queue_sasl_2:19093',
    properties.sasl.username = 'dev1'
);

query I
select count(*) from rw_tables
where name = 't_alter_bs_fewer'
  and definition ilike '%properties.bootstrap.server = ''message_queue_sasl_1:19092''%';
----
1

# ==== sink ====

system ok
rpk topic delete test_alter_bs_sink -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw || true

system ok
rpk topic create test_alter_bs_sink -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
rpk topic delete test_alter_bs_sink -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw || true

system ok
rpk topic create test_alter_bs_sink -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw

statement ok
create table t_alter_bs_sink_src (v int);

statement ok
create sink sink_alter_bs from t_alter_bs_sink_src with (
    connector = 'kafka',
    properties.bootstrap.server = 'message_queue_sasl_1:19092',
    properties.security.protocol = 'SASL_PLAINTEXT',
    properties.sasl.mechanism = 'PLAIN',
    properties.sasl.username = 'dev',
    properties.sasl.password = 'rw',
    topic = 'test_alter_bs_sink'
) format plain encode json;

statement ok
insert into t_alter_bs_sink_src values (1);

statement ok
flush;

system ok retry 10 backoff 2s
rpk topic consume test_alter_bs_sink --offset start --num 1 -f '%v\n' -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw | grep -q '"v":1'

# The new brokers are validated before anything is changed.
statement error cannot connect to kafka broker \(message_queue_sasl_2:19093\)
alter sink sink_alter_bs connector with (properties.bootstrap.server = 'message_queue_sasl_2:19093');

query I
select count(*) from rw_sinks
where name = 'sink_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''message_queue_sasl_1:19092''%';
----
1

statement ok
alter sink sink_alter_bs connector with (
    properties.bootstrap.server = 'message_queue_sasl_2:19093',
    properties.sasl.username = 'dev1'
);

query I
select count(*) from rw_sinks
where name = 'sink_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''message_queue_sasl_2:19093''%'
  and definition ilike '%properties.sasl.username = ''dev1''%';
----
1

statement ok
insert into t_alter_bs_sink_src values (2);

statement ok
flush;

# New rows are delivered to the new cluster. The sink is at-least-once, so rows written before the
# change may be delivered to the new cluster as well.
system ok retry 10 backoff 2s
timeout 5 rpk topic consume test_alter_bs_sink --offset start -f '%v\n' -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw | grep -q '"v":2'

# ==== clean up ====

statement ok
drop sink sink_alter_bs;

statement ok
drop table t_alter_bs_sink_src;

statement ok
drop table t_alter_bs_fewer;

statement ok
drop table t_alter_bs;

statement ok
drop source s_alter_bs cascade;

system ok
rpk topic delete test_alter_bs -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
rpk topic delete test_alter_bs -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw

system ok
rpk topic delete test_alter_bs_fewer -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
rpk topic delete test_alter_bs_fewer -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw

system ok
rpk topic delete test_alter_bs_sink -X brokers=message_queue_sasl_1:19092 -X sasl.mechanism=PLAIN -X user=dev -X pass=rw

system ok
rpk topic delete test_alter_bs_sink -X brokers=message_queue_sasl_2:19093 -X sasl.mechanism=PLAIN -X user=dev1 -X pass=rw
