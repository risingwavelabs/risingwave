control substitution on

system ok
rpk topic delete -r '^alter_sink_secret_runtime$'

system ok
rpk topic create alter_sink_secret_runtime -p 1

statement ok
SET sink_decouple = true;

statement ok
CREATE SECRET old_message_limit WITH (backend = 'meta') AS '1000';

statement ok
CREATE SECRET new_message_limit WITH (backend = 'meta') AS '10000';

statement ok
CREATE TABLE secret_runtime_input (id INT PRIMARY KEY, payload VARCHAR);

statement ok
CREATE SINK secret_runtime_sink FROM secret_runtime_input WITH (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'alter_sink_secret_runtime',
    primary_key = 'id',
    properties.message.max.bytes = SECRET old_message_limit,
    properties.compression.codec = 'none'
) FORMAT UPSERT ENCODE JSON;

statement ok
CREATE TABLE secret_runtime_output (id INT, payload VARCHAR, PRIMARY KEY (rw_key)) INCLUDE KEY AS rw_key WITH (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'alter_sink_secret_runtime',
    scan.startup.mode = 'earliest'
) FORMAT UPSERT ENCODE JSON;

statement ok
INSERT INTO secret_runtime_input VALUES (1, repeat('a', 100));

query II retry 30 backoff 1s
SELECT id, length(payload) FROM secret_runtime_output ORDER BY id;
----
1 100

statement error
DROP SECRET old_message_limit;

# Secret -> Secret must update both the dependency and the running producer.
statement ok
ALTER SINK secret_runtime_sink CONNECTOR WITH (
    properties.message.max.bytes = SECRET new_message_limit
);

query T
SELECT connector_props->'properties.message.max.bytes'->'value'->>'value'
FROM rw_sinks WHERE name = 'secret_runtime_sink';
----
new_message_limit

statement ok
DROP SECRET old_message_limit;

statement error
DROP SECRET new_message_limit;

# A producer still using the old 1000-byte limit cannot send this row.
statement ok
INSERT INTO secret_runtime_input VALUES (2, repeat('b', 4000));

query II retry 30 backoff 1s
SELECT id, length(payload) FROM secret_runtime_output ORDER BY id;
----
1 100
2 4000

# Secret -> plaintext must release the dependency and update the producer again.
statement ok
ALTER SINK secret_runtime_sink CONNECTOR WITH (properties.message.max.bytes = '20000');

query T
SELECT connector_props->'properties.message.max.bytes'->>'type'
FROM rw_sinks WHERE name = 'secret_runtime_sink';
----
plaintext

statement ok
DROP SECRET new_message_limit;

# This row also exceeds the previous 10000-byte limit.
statement ok
INSERT INTO secret_runtime_input VALUES (3, repeat('c', 12000));

query II retry 30 backoff 1s
SELECT id, length(payload) FROM secret_runtime_output ORDER BY id;
----
1 100
2 4000
3 12000

statement ok
DROP TABLE secret_runtime_output;

statement ok
DROP SINK secret_runtime_sink;

statement ok
DROP TABLE secret_runtime_input;

statement ok
SET sink_decouple = default;

system ok
rpk topic delete alter_sink_secret_runtime
