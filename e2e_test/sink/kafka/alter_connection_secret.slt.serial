# RECOVER checks that connection updates persist Secret references in both sink fragments.
control substitution on

system ok
rpk topic delete -r '^alter_connection_secret_[12]$'

system ok
rpk topic create alter_connection_secret_1 alter_connection_secret_2 -p 1

statement ok
SET sink_decouple = true;

statement ok
CREATE SECRET conn_broker WITH (backend = 'meta') AS '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}';

statement ok
CREATE SECRET conn_old WITH (backend = 'meta') AS 'old-credential';

statement ok
CREATE SECRET conn_new WITH (backend = 'meta') AS 'new-credential';

statement ok
CREATE SECRET conn_invalid WITH (backend = 'meta') AS 'invalid-protocol';

statement ok
CREATE CONNECTION secret_conn WITH (
    type = 'kafka',
    properties.bootstrap.server = SECRET conn_broker,
    properties.security.protocol = 'PLAINTEXT',
    properties.sasl.username = 'unused',
    properties.sasl.password = 'unused'
);

statement ok
CREATE TABLE conn_input (id INT PRIMARY KEY);

statement ok
CREATE SINK conn_sink_1 FROM conn_input WITH (
    connector = 'kafka', connection = secret_conn,
    topic = 'alter_connection_secret_1', primary_key = 'id'
) FORMAT UPSERT ENCODE JSON;

statement ok
CREATE SINK conn_sink_2 FROM conn_input WITH (
    connector = 'kafka', connection = secret_conn,
    topic = 'alter_connection_secret_2', primary_key = 'id'
) FORMAT UPSERT ENCODE JSON;

statement ok
CREATE TABLE conn_output_1 (id INT, PRIMARY KEY (rw_key)) INCLUDE KEY AS rw_key WITH (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'alter_connection_secret_1', scan.startup.mode = 'earliest'
) FORMAT UPSERT ENCODE JSON;

statement ok
CREATE TABLE conn_output_2 (id INT, PRIMARY KEY (rw_key)) INCLUDE KEY AS rw_key WITH (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'alter_connection_secret_2', scan.startup.mode = 'earliest'
) FORMAT UPSERT ENCODE JSON;

# An unrelated plaintext update must resolve the existing required broker Secret.
statement ok
ALTER CONNECTION secret_conn CONNECTOR WITH (properties.sasl.username = 'unused-new');

# Plaintext -> Secret. Both dependent sinks must acquire references and dependencies.
# SASL options are ignored by this plaintext broker; recovery below checks persisted refs.
statement ok
ALTER CONNECTION secret_conn CONNECTOR WITH (
    properties.sasl.username = SECRET conn_old,
    properties.sasl.password = SECRET conn_old
);

query TT rowsort
SELECT name, connector_props->'properties.sasl.password'->'value'->>'value'
FROM rw_sinks WHERE name IN ('conn_sink_1', 'conn_sink_2');
----
conn_sink_1 conn_old
conn_sink_2 conn_old

statement error Permission denied: secret used by 3 other objects.
DROP SECRET conn_old;

# Validation failures must leave the connection and its dependents untouched.
statement error
ALTER CONNECTION secret_conn CONNECTOR WITH (properties.security.protocol = SECRET conn_invalid);

statement error
ALTER CONNECTION secret_conn CONNECTOR WITH (topic = SECRET conn_invalid);

statement ok
DROP SECRET conn_invalid;

query I
SELECT count(*) FROM rw_sinks WHERE name IN ('conn_sink_1', 'conn_sink_2')
  AND connector_props->'properties.security.protocol'->>'value' = 'PLAINTEXT';
----
2

# Rotating one field must retain the old dependency while another field still uses it.
statement ok
ALTER CONNECTION secret_conn CONNECTOR WITH (properties.sasl.password = SECRET conn_new);

statement error Permission denied: secret used by 3 other objects.
DROP SECRET conn_old;

statement ok
ALTER CONNECTION secret_conn CONNECTOR WITH (properties.sasl.username = SECRET conn_new);

statement ok
DROP SECRET conn_old;

statement error Permission denied: secret used by 3 other objects.
DROP SECRET conn_new;

query TT rowsort
SELECT name, connector_props->'properties.sasl.password'->'value'->>'value'
FROM rw_sinks WHERE name IN ('conn_sink_1', 'conn_sink_2');
----
conn_sink_1 conn_new
conn_sink_2 conn_new

# Preserve CONNECTION in the SQL definition without inlining inherited secrets or values.
query I
SELECT count(*) FROM rw_sinks WHERE name IN ('conn_sink_1', 'conn_sink_2')
  AND definition ILIKE '%connection = secret_conn%'
  AND definition NOT ILIKE '%properties.sasl%'
  AND connector_props::varchar NOT LIKE '%new-credential%';
----
2

statement ok
INSERT INTO conn_input VALUES (1);

query II rowsort retry 30 backoff 1s
SELECT 1, id FROM conn_output_1 UNION ALL SELECT 2, id FROM conn_output_2;
----
1 1
2 1

# Stale fragment references would now point at the dropped conn_old Secret.
statement ok
RECOVER;

statement ok
INSERT INTO conn_input VALUES (2);

query II rowsort retry 30 backoff 1s
SELECT 1, id FROM conn_output_1 UNION ALL SELECT 2, id FROM conn_output_2;
----
1 1
1 2
2 1
2 2

# Secret -> plaintext must remove the old references from connection and sink fragments.
statement ok
ALTER CONNECTION secret_conn CONNECTOR WITH (
    properties.sasl.username = 'unused',
    properties.sasl.password = 'unused'
);

query TT rowsort
SELECT name, connector_props->'properties.sasl.password'->>'type'
FROM rw_sinks WHERE name IN ('conn_sink_1', 'conn_sink_2');
----
conn_sink_1 plaintext
conn_sink_2 plaintext

statement ok
DROP SECRET conn_new;

statement ok
RECOVER;

statement ok
INSERT INTO conn_input VALUES (3);

query II rowsort retry 30 backoff 1s
SELECT 1, id FROM conn_output_1 UNION ALL SELECT 2, id FROM conn_output_2;
----
1 1
1 2
1 3
2 1
2 2
2 3

statement ok
DROP TABLE conn_output_1;

statement ok
DROP TABLE conn_output_2;

statement ok
DROP SINK conn_sink_1;

statement ok
DROP SINK conn_sink_2;

statement ok
DROP TABLE conn_input;

statement ok
DROP CONNECTION secret_conn;

statement ok
DROP SECRET conn_broker;

statement ok
SET sink_decouple = default;

system ok
rpk topic delete alter_connection_secret_1 alter_connection_secret_2
