# RECOVER verifies that persisted fragment metadata uses the updated Secret references.
control substitution on

system ok
rpk topic delete -r '^alter_sink_secret_roundtrip$'

system ok
rpk topic create alter_sink_secret_roundtrip -p 1

statement ok
SET sink_decouple = true;

statement ok
CREATE SCHEMA secrets;

statement ok
CREATE SECRET secrets.broker WITH (backend = 'meta') AS '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}';

statement ok
CREATE SECRET secrets.old_value WITH (backend = 'meta') AS '10000';

statement ok
CREATE SECRET secrets.new_value WITH (backend = 'meta') AS '20000';

statement ok
CREATE SECRET secrets.invalid_value WITH (backend = 'meta') AS 'invalid-number';

statement ok
CREATE TABLE t_in (id INT PRIMARY KEY);

statement ok
CREATE SINK s FROM t_in WITH (
    connector = 'kafka',
    properties.bootstrap.server = SECRET secrets.broker,
    topic = 'alter_sink_secret_roundtrip',
    primary_key = 'id',
    properties.batch.num.messages = '5000'
) FORMAT UPSERT ENCODE JSON;

statement ok
CREATE TABLE t_out (id INT, PRIMARY KEY (rw_key)) INCLUDE KEY AS rw_key WITH (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'alter_sink_secret_roundtrip',
    scan.startup.mode = 'earliest'
) FORMAT UPSERT ENCODE JSON;

# Plaintext -> Secret; an existing required Secret property must also be resolved.
statement ok
ALTER SINK s CONNECTOR WITH (
    properties.batch.num.messages = SECRET secrets.old_value,
    properties.batch.size = SECRET secrets.old_value
);

query T
SELECT connector_props->'properties.batch.num.messages'->>'type' FROM rw_sinks WHERE name = 's';
----
secret

query I
SELECT count(*) FROM rw_sinks WHERE name = 's'
  AND definition ILIKE '%properties.batch.num.messages = secret "secrets".old_value%'
  AND definition NOT LIKE '%10000%'
  AND connector_props::varchar NOT LIKE '%10000%';
----
1

statement error
DROP SECRET secrets.old_value;

# Secret keys must pass the same allowlist as plaintext keys.
statement error Field 'topic' is not allowed to be altered on the fly for sink: kafka
ALTER SINK s CONNECTOR WITH (topic = SECRET secrets.new_value);

# Invalid resolved values must fail before modifying catalog state or dependencies.
statement error
ALTER SINK s CONNECTOR WITH (properties.batch.num.messages = SECRET secrets.invalid_value);

query T
SELECT connector_props->'properties.batch.num.messages'->'value'->>'value' FROM rw_sinks WHERE name = 's';
----
old_value

statement ok
DROP SECRET secrets.invalid_value;

# Rotating one of two references must retain the old Secret's dependency.
statement ok
ALTER SINK s CONNECTOR WITH (properties.batch.num.messages = SECRET secrets.new_value);

statement error
DROP SECRET secrets.old_value;

statement ok
ALTER SINK s CONNECTOR WITH (properties.batch.size = SECRET secrets.new_value);

statement ok
DROP SECRET secrets.old_value;

statement error
DROP SECRET secrets.new_value;

statement ok
INSERT INTO t_in VALUES (1);

query I retry 30 backoff 1s
SELECT id FROM t_out ORDER BY id;
----
1

# A stale Secret reference in the fragment would now refer to a dropped Secret.
statement ok
RECOVER;

statement ok
INSERT INTO t_in VALUES (2);

query I retry 30 backoff 1s
SELECT id FROM t_out ORDER BY id;
----
1
2

# Ordinary updates still work when other properties are Secret-backed.
statement ok
ALTER SINK s CONNECTOR WITH (properties.queue.buffering.max.ms = '10');

# Secret -> plaintext must remove both references and the final dependency.
statement ok
ALTER SINK s CONNECTOR WITH (
    properties.batch.num.messages = '30000',
    properties.batch.size = '30000'
);

query T
SELECT connector_props->'properties.batch.num.messages'->>'type' FROM rw_sinks WHERE name = 's';
----
plaintext

query I
SELECT count(*) FROM rw_sinks WHERE name = 's'
  AND definition ILIKE '%properties.batch.num.messages = ''30000''%'
  AND definition NOT ILIKE '%secret "secrets".new_value%';
----
1

statement ok
DROP SECRET secrets.new_value;

statement ok
RECOVER;

statement ok
INSERT INTO t_in VALUES (3);

query I retry 30 backoff 1s
SELECT id FROM t_out ORDER BY id;
----
1
2
3

statement ok
DROP TABLE t_out;

statement ok
DROP SINK s;

statement ok
DROP TABLE t_in;

statement ok
DROP SECRET secrets.broker;

statement ok
DROP SCHEMA secrets;

statement ok
SET sink_decouple = default;

system ok
rpk topic delete alter_sink_secret_roundtrip
