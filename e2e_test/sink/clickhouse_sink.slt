control substitution on

statement ok
DROP SINK IF EXISTS s6;

statement ok
DROP MATERIALIZED VIEW IF EXISTS mv6;

statement ok
DROP TABLE IF EXISTS t6;

# v9 is left out of the sink on purpose: a Decimal256 column the sink does not write must not break it.
system ok
clickhouse --multiquery --query="DROP TABLE IF EXISTS demo_test; SET enable_json_type = 1; CREATE TABLE demo_test(v1 Int32, v2 Int64, v3 String, v4 Enum16('A'=1,'B'=2), v5 Decimal64(3), v6 Nullable(String), v7 DateTime64(6), v8 JSON, v9 Decimal(76, 4)) ENGINE = ReplacingMergeTree PRIMARY KEY (v1);"

statement ok
set sink_decouple = false;

statement ok
CREATE TABLE t6 (v1 int primary key, v2 bigint, v3 varchar, v4 smallint, v5 decimal, v6 timestamptz, v7 jsonb);

statement ok
CREATE MATERIALIZED VIEW mv6 AS SELECT * FROM t6;

statement ok
CREATE SINK s6 AS select mv6.v1 as v1, mv6.v2 as v2, mv6.v3 as v3, mv6.v4 as v4, mv6.v5 as v5, mv6.v6 as v7, mv6.v7 as v8 from mv6 WITH (
    ${RISEDEV_CLICKHOUSE_WITH_OPTIONS_COMMON},
    type = 'append-only',
    force_append_only='true',
    clickhouse.table='demo_test',
);

# verify `commit_checkpoint_interval` can be altered
statement ok
ALTER SINK s6 CONNECTOR WITH (
    commit_checkpoint_interval = '1'
);

query I
select count(*)
from rw_sinks
where name = 's6'
  and definition ILIKE '%commit_checkpoint_interval = ''1''%';
----
1

statement ok
INSERT INTO t6 VALUES (1, 50, '1-50', 1, 1.1, '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (2, 2, '2-2', 2, 2.2, '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (3, 2, '3-2', 1, 3.3, '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (5, 2, '5-2', 2, 4.4, '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (8, 2, '8-2', 1, 'inf', '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (13, 2, '13-2', 2, '-inf', '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}'), (21, 2, '21-2', 1, 'nan', '2013-01-01 01:01:01+01:00', '{"sd":123,"sda":23}');

statement ok
FLUSH;

system ok retry 30 backoff 1s
test "$(clickhouse --query="SELECT count() FROM demo_test WHERE (v1, v2, v3, toString(v4), v5) IN ((1,50,'1-50','A',1.1),(2,2,'2-2','B',2.2),(3,2,'3-2','A',3.3),(5,2,'5-2','B',4.4),(8,2,'8-2','A',0),(13,2,'13-2','B',0),(21,2,'21-2','A',0)) AND isNull(v6) AND v7 = toDateTime64('2013-01-01 00:01:01', 6) AND toString(v8.sd) = '123' AND toString(v8.sda) = '23'")" = 7

statement ok
DROP SINK s6;

statement ok
DROP MATERIALIZED VIEW mv6;

statement ok
DROP TABLE t6;

system ok
clickhouse --query="DROP TABLE demo_test"

# Verify delete column validation and insert, update, and delete behavior with a valid UInt8 column.
statement ok
DROP SINK IF EXISTS ck_delete_sink;

statement ok
DROP TABLE IF EXISTS ck_delete_source;

system ok
clickhouse --multiquery --query="DROP TABLE IF EXISTS ck_delete_target; CREATE TABLE ck_delete_target(k Int32, ver UInt64, v String, is_deleted UInt8, nullable_flag Nullable(UInt8), wide_flag UInt32) ENGINE = ReplacingMergeTree(ver, is_deleted) ORDER BY k;"

statement ok
CREATE TABLE ck_delete_source (k int PRIMARY KEY, ver bigint, v varchar);

statement error clickhouse\.delete\.column.*"is_delete".*does not exist
CREATE SINK ck_delete_sink FROM ck_delete_source WITH (
    ${RISEDEV_CLICKHOUSE_WITH_OPTIONS_COMMON},
    type = 'upsert',
    primary_key = 'k',
    clickhouse.table = 'ck_delete_target',
    clickhouse.delete.column = 'is_delete'
);

statement error clickhouse\.delete\.column.*"nullable_flag".*Nullable\(UInt8\).*expected UInt8 or Int8
CREATE SINK ck_delete_sink FROM ck_delete_source WITH (
    ${RISEDEV_CLICKHOUSE_WITH_OPTIONS_COMMON},
    type = 'upsert',
    primary_key = 'k',
    clickhouse.table = 'ck_delete_target',
    clickhouse.delete.column = 'nullable_flag'
);

statement error clickhouse\.delete\.column.*"wide_flag".*UInt32.*expected UInt8 or Int8
CREATE SINK ck_delete_sink FROM ck_delete_source WITH (
    ${RISEDEV_CLICKHOUSE_WITH_OPTIONS_COMMON},
    type = 'upsert',
    primary_key = 'k',
    clickhouse.table = 'ck_delete_target',
    clickhouse.delete.column = 'wide_flag'
);

statement ok
CREATE SINK ck_delete_sink FROM ck_delete_source WITH (
    ${RISEDEV_CLICKHOUSE_WITH_OPTIONS_COMMON},
    type = 'upsert',
    primary_key = 'k',
    clickhouse.table = 'ck_delete_target',
    clickhouse.delete.column = 'is_deleted',
    commit_checkpoint_interval = '1'
);

statement ok
INSERT INTO ck_delete_source VALUES (1, 1, 'before'), (2, 1, 'to delete');

statement ok
FLUSH;

system ok retry 60 backoff 2s
test "$(clickhouse --query="SELECT count() = 2 AND countIf((k, ver, v, is_deleted) = (1, 1, 'before', 0)) = 1 AND countIf((k, ver, v, is_deleted) = (2, 1, 'to delete', 0)) = 1 FROM ck_delete_target FINAL")" = 1

statement ok
UPDATE ck_delete_source SET ver = 2, v = 'after' WHERE k = 1;

statement ok
FLUSH;

system ok retry 60 backoff 2s
test "$(clickhouse --query="SELECT count() = 2 AND countIf((k, ver, v, is_deleted) = (1, 2, 'after', 0)) = 1 AND countIf((k, ver, v, is_deleted) = (2, 1, 'to delete', 0)) = 1 FROM ck_delete_target FINAL")" = 1

statement ok
DELETE FROM ck_delete_source WHERE k = 2;

statement ok
FLUSH;

system ok retry 60 backoff 2s
test "$(clickhouse --query="SELECT count() = 1 AND countIf((k, ver, v, is_deleted) = (1, 2, 'after', 0)) = 1 FROM ck_delete_target FINAL")" = 1

statement ok
DROP SINK ck_delete_sink;

statement ok
DROP TABLE ck_delete_source;

system ok
clickhouse --query="DROP TABLE ck_delete_target"
