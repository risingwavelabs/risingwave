SET RW_IMPLICIT_FLUSH TO true;

statement ok
CREATE SECRET qdrant_api_key WITH (backend = 'meta') AS 'qdrant_test_key';

statement ok
CREATE TABLE qdrant_unnamed_items (
    id bigint primary key,
    body varchar,
    price decimal,
    published_at timestamptz,
    embedding vector(3)
);

statement ok
INSERT INTO qdrant_unnamed_items VALUES
    (1, 'first', 1.5, '2026-06-16 01:02:03+00:00', '[0.1,0.2,0.3]'),
    (2, 'second', 2.5, '2026-06-16 02:03:04+00:00', '[0.2,0.3,0.4]'),
    (3, 'third', 3.5, '2026-06-16 03:04:05+00:00', '[0.3,0.4,0.5]');

statement ok
CREATE SINK qdrant_unnamed_sink FROM qdrant_unnamed_items WITH (
    connector = 'qdrant',
    url = 'http://qdrant-server:6334',
    collection_name = 'rw_unnamed',
    api_key = secret qdrant_api_key,
    primary_key = 'id',
    type = 'upsert',
    write_batch_size = 2
);

