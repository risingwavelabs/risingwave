# Copy to a private, gitignored path. Values here are placeholders only.
REDSHIFT_JDBC_URL=jdbc:redshift://YOUR_ENDPOINT:5439/YOUR_DATABASE
REDSHIFT_USER=YOUR_TEST_USER
REDSHIFT_PASSWORD=YOUR_TEST_PASSWORD
REDSHIFT_SCHEMA=YOUR_DISPOSABLE_SCHEMA

# Required only for --mode s3 or --mode both.
S3_BUCKET=YOUR_TEST_BUCKET
S3_PREFIX=redshift-e2e
AWS_REGION=YOUR_REDSHIFT_REGION
AWS_ACCESS_KEY_ID=YOUR_TEST_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_TEST_SECRET_KEY
