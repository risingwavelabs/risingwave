# Updates of existing groups, with group keys in a different scale, must reach the existing
# aggregation states instead of creating duplicate groups.
statement ok
INSERT INTO decimal_src SELECT (i % 40)::DECIMAL / 8 * 1.00, i FROM generate_series(2001, 2400) AS s(i);

statement ok
DELETE FROM decimal_src WHERE v <= 400;

