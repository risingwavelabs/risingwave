statement ok
DROP SINK bounded_src_sink;

statement ok
DROP MATERIALIZED VIEW bounded_src_recovered;

statement ok
DROP MATERIALIZED VIEW bounded_src_count;

statement ok
DROP MATERIALIZED VIEW bounded_src_rows;

query I
SELECT count(*) FROM rw_bounded_jobs;
----
0

statement ok
DROP SOURCE bounded_src_first;

statement ok
DROP SOURCE bounded_src;

statement ok
DROP SOURCE bounded_src_upstream_src;

statement ok
DROP TABLE bounded_src_upstream;

system ok
./risedev mc rm --recursive --force hummock-minio/hummock001/bounded_iceberg_source/

system ok
./risedev mc rm --recursive --force hummock-minio/hummock001/bounded_iceberg_source_parked/
