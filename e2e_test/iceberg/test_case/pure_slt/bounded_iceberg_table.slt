# Bounded Iceberg tables load one pinned snapshot once and then stop.
#
# The upstream Iceberg table is written by a Rust Iceberg sink. A plain Iceberg source on the same
# table exposes its snapshot ids through `rw_iceberg_snapshots`.

statement ok
DROP TABLE IF EXISTS bounded_first;

statement ok
DROP TABLE IF EXISTS bounded_latest;

statement ok
DROP SOURCE IF EXISTS bounded_upstream_src;

statement ok
DROP SINK IF EXISTS bounded_upstream_sink;

statement ok
DROP TABLE IF EXISTS bounded_upstream;

system ok
./risedev mc rm --recursive --force hummock-minio/hummock001/bounded_iceberg/

statement ok
SET sink_decouple = false;

statement ok
CREATE TABLE bounded_upstream (id INT, v VARCHAR) APPEND ONLY;

statement ok
CREATE SINK bounded_upstream_sink FROM bounded_upstream WITH (
    connector = 'iceberg',
    type = 'append-only',
    warehouse.path = 's3://hummock001/bounded_iceberg',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    catalog.type = 'storage',
    database.name = 'bounded_db',
    table.name = 'bounded_t',
    commit_checkpoint_interval = 1,
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO bounded_upstream VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
FLUSH;

statement ok
CREATE SOURCE bounded_upstream_src WITH (
    connector = 'iceberg',
    warehouse.path = 's3://hummock001/bounded_iceberg',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    catalog.type = 'storage',
    database.name = 'bounded_db',
    table.name = 'bounded_t'
);

query I retry 30 backoff 1s
SELECT count(*) FROM rw_iceberg_snapshots WHERE source_name = 'bounded_upstream_src';
----
1

statement ok
INSERT INTO bounded_upstream VALUES (4, 'd'), (5, 'e');

statement ok
FLUSH;

query I retry 30 backoff 1s
SELECT count(*) FROM rw_iceberg_snapshots WHERE source_name = 'bounded_upstream_src';
----
2

# ==== option validation

statement error `scan.bounded.snapshot.id` is required when `scan.bounded.mode` is 'snapshot'
CREATE TABLE bounded_invalid (PRIMARY KEY (id)) WITH (
    connector = 'iceberg',
    warehouse.path = 's3://hummock001/bounded_iceberg',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    catalog.type = 'storage',
    database.name = 'bounded_db',
    table.name = 'bounded_t',
    scan.bounded.mode = 'snapshot'
);

statement error `scan.bounded.snapshot.id` must be an integer
CREATE TABLE bounded_invalid (PRIMARY KEY (id)) WITH (
    connector = 'iceberg',
    warehouse.path = 's3://hummock001/bounded_iceberg',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    catalog.type = 'storage',
    database.name = 'bounded_db',
    table.name = 'bounded_t',
    scan.bounded.mode = 'snapshot',
    scan.bounded.snapshot.id = 'latest'
);

statement error snapshot 1 does not exist in the Iceberg table
