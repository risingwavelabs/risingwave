# Test that copy-on-write is rejected for append-only Iceberg sinks.
#
# Keep this test side-effect free on the external Iceberg catalog. Successful
# auto-create sinks initialize their target table asynchronously, so dropping
# the sink and table back-to-back can race and leak a recreated table into the
# benchmark phase that follows the pure SLT suite.

statement ok
CREATE TABLE t_append_only (
    id bigint primary key,
    data varchar
);

statement error 'copy-on-write' mode is not supported for append-only iceberg sink
CREATE SINK s_append_only_cow AS SELECT * FROM t_append_only WITH (
    connector = 'iceberg',
    type = 'append-only',
    force_append_only = 'true',
    database.name = 'demo_db',
    table.name = 'test_append_only_cow',
    catalog.name = 'demo',
    catalog.type = 'storage',
    warehouse.path = 's3a://icebergdata/demo',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    create_table_if_not_exists = 'true',
    write_mode = 'copy-on-write'
);

statement ok
DROP TABLE t_append_only;
