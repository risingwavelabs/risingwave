# Test enforcement of merge-on-read write mode for append-only Iceberg sinks.

system ok
sparksql --e "
DROP TABLE IF EXISTS demo.demo_db.test_append_only_cow PURGE;
DROP TABLE IF EXISTS demo.demo_db.test_append_only_mor PURGE;
DROP TABLE IF EXISTS demo.demo_db.test_append_only_default PURGE;
CREATE TABLE demo.demo_db.test_append_only_mor (id BIGINT, data STRING)
TBLPROPERTIES ('format-version'='2');
CREATE TABLE demo.demo_db.test_append_only_default (id BIGINT, data STRING)
TBLPROPERTIES ('format-version'='2');
"

statement ok
SET sink_decouple = false;

statement ok
CREATE TABLE t_append_only (
    id bigint primary key,
    data varchar
);

# Copy-on-write must be rejected.
statement error 'copy-on-write' mode is not supported for append-only iceberg sink
CREATE SINK s_append_only_cow AS SELECT * FROM t_append_only WITH (
    connector = 'iceberg',
    type = 'append-only',
    force_append_only = 'true',
    database.name = 'demo_db',
    table.name = 'test_append_only_cow',
    catalog.name = 'demo',
    catalog.type = 'storage',
    warehouse.path = 's3a://icebergdata/demo',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    create_table_if_not_exists = 'true',
    write_mode = 'copy-on-write'
);

# Explicit merge-on-read must work.
statement ok
CREATE SINK s_append_only_mor AS SELECT * FROM t_append_only WITH (
    connector = 'iceberg',
    type = 'append-only',
    force_append_only = 'true',
    database.name = 'demo_db',
    table.name = 'test_append_only_mor',
    catalog.name = 'demo',
    catalog.type = 'storage',
    warehouse.path = 's3a://icebergdata/demo',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    create_table_if_not_exists = 'false',
    write_mode = 'merge-on-read'
);

# Exercise the sink writer before dropping it. The external target is
# pre-created and auto-creation is disabled so that a delayed writer cannot
# recreate the table after the cleanup below.
statement ok
INSERT INTO t_append_only VALUES (1, 'explicit');

statement ok
FLUSH;

statement ok
DROP SINK s_append_only_mor;

# Omitting write_mode must default to merge-on-read.
statement ok
CREATE SINK s_append_only_default AS SELECT * FROM t_append_only WITH (
    connector = 'iceberg',
    type = 'append-only',
    force_append_only = 'true',
    database.name = 'demo_db',
    table.name = 'test_append_only_default',
    catalog.name = 'demo',
    catalog.type = 'storage',
    warehouse.path = 's3a://icebergdata/demo',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-east-1',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    create_table_if_not_exists = 'false'
);

statement ok
INSERT INTO t_append_only VALUES (2, 'default');

statement ok
FLUSH;

statement ok
DROP SINK s_append_only_default;

statement ok
DROP TABLE t_append_only;

system ok
sparksql --e "
DROP TABLE IF EXISTS demo.demo_db.test_append_only_cow PURGE;
DROP TABLE IF EXISTS demo.demo_db.test_append_only_mor PURGE;
DROP TABLE IF EXISTS demo.demo_db.test_append_only_default PURGE;
"
