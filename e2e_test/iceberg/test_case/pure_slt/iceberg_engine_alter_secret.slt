statement ok
SET sink_decouple = true;

statement ok
SET iceberg_query_storage_mode = 'iceberg';

statement ok
CREATE SCHEMA s;

statement ok
CREATE SECRET s.key1 WITH (backend = 'meta') AS 'hummockadmin';

statement ok
CREATE SECRET s.key2 WITH (backend = 'meta') AS 'hummockadmin';

statement ok
CREATE SECRET s.bad_interval WITH (backend = 'meta') AS 'not-a-number';

statement ok
CREATE SECRET s.interval WITH (backend = 'meta') AS '1';

statement ok
CREATE CONNECTION conn WITH (
    type = 'iceberg',
    warehouse.path = 's3://hummock001/iceberg_engine_alter_secret',
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    s3.endpoint = 'http://127.0.0.1:9301',
    s3.region = 'us-west-2',
    catalog.type = 'storage'
);

statement ok
SET iceberg_engine_connection = 'public.conn';

statement ok
CREATE TABLE t (id INT PRIMARY KEY, name VARCHAR) WITH (
    commit_checkpoint_interval = 1,
    enable_compaction = false
) ENGINE = ICEBERG;

# Plaintext -> Secret must update the implicit source as well as the sink.
statement ok
ALTER TABLE t CONNECTOR WITH (
    s3.access.key = SECRET s.key1,
    s3.secret.key = SECRET s.key1,
    commit_checkpoint_interval = SECRET s.interval
);

query TTT rowsort
SELECT 'sink', connector_props->'s3.access.key'->>'type', connector_props->'s3.secret.key'->>'type'
FROM rw_sinks WHERE name = '__iceberg_sink_t'
UNION ALL
SELECT 'source', connector_props->'s3.access.key'->>'type', connector_props->'s3.secret.key'->>'type'
FROM rw_sources WHERE name = '__iceberg_source_t';
----
sink secret secret
source secret secret

# Sink-only options must not be copied into the source's connector configuration.
query T
SELECT connector_props->'commit_checkpoint_interval' IS NULL
FROM rw_sources WHERE name = '__iceberg_source_t';
----
t

query I
SELECT count(*) FROM (
    SELECT definition FROM rw_tables WHERE name = 't'
    UNION ALL
    SELECT definition FROM rw_sinks WHERE name = '__iceberg_sink_t'
    UNION ALL
    SELECT definition FROM rw_sources WHERE name = '__iceberg_source_t'
) AS definitions
WHERE definition ILIKE '%s3."secret"."key" = secret s.key1%'
  AND definition NOT LIKE '%hummockadmin%';
----
3

statement error
DROP SECRET s.key1;

statement error
DROP SECRET s.interval;

statement error ALTER ICEBERG TABLE does not support CONNECTION
ALTER TABLE t CONNECTOR WITH (connection = conn);

# Invalid resolved values must roll back the entire update and its dependencies.
statement error
ALTER TABLE t CONNECTOR WITH (
    s3.access.key = SECRET s.key2,
    commit_checkpoint_interval = SECRET s.bad_interval
);

query TT rowsort
SELECT 'sink', connector_props->'s3.access.key'->'value'->>'value'
FROM rw_sinks WHERE name = '__iceberg_sink_t'
UNION ALL
SELECT 'source', connector_props->'s3.access.key'->'value'->>'value'
FROM rw_sources WHERE name = '__iceberg_source_t';
----
sink key1
source key1

statement ok
DROP SECRET s.bad_interval;

# Rotating one of two references must keep the old Secret protected.
statement ok
ALTER TABLE t CONNECTOR WITH (s3.access.key = SECRET s.key2);

statement error
DROP SECRET s.key1;

statement ok
ALTER TABLE t CONNECTOR WITH (s3.secret.key = SECRET s.key2);

statement ok
DROP SECRET s.key1;

statement error
DROP SECRET s.key2;

query TT rowsort
SELECT 'sink', connector_props->'s3.secret.key'->'value'->>'value'
FROM rw_sinks WHERE name = '__iceberg_sink_t'
UNION ALL
SELECT 'source', connector_props->'s3.secret.key'->'value'->>'value'
FROM rw_sources WHERE name = '__iceberg_source_t';
----
sink key2
source key2

statement ok
INSERT INTO t VALUES (1, 'rotated');

statement ok
FLUSH;

# Read from Iceberg, so success requires both sink commits and source reads.
query IT retry 30 backoff 1s
SELECT * FROM t ORDER BY id;
----
1 rotated

# Ordinary changes must resolve the existing Secrets during validation.
statement ok
ALTER TABLE t CONNECTOR WITH (enable_compaction = 'false');

# Secret -> plaintext removes references and releases the final dependencies.
statement ok
ALTER TABLE t CONNECTOR WITH (
    s3.access.key = 'hummockadmin',
    s3.secret.key = 'hummockadmin',
    commit_checkpoint_interval = '1'
);

query TTT rowsort
SELECT 'sink', connector_props->'s3.access.key'->>'type', connector_props->'s3.secret.key'->>'type'
FROM rw_sinks WHERE name = '__iceberg_sink_t'
UNION ALL
SELECT 'source', connector_props->'s3.access.key'->>'type', connector_props->'s3.secret.key'->>'type'
FROM rw_sources WHERE name = '__iceberg_source_t';
----
sink plaintext plaintext
source plaintext plaintext

query I
SELECT count(*) FROM (
    SELECT definition FROM rw_tables WHERE name = 't'
    UNION ALL
    SELECT definition FROM rw_sinks WHERE name = '__iceberg_sink_t'
    UNION ALL
    SELECT definition FROM rw_sources WHERE name = '__iceberg_source_t'
) AS definitions WHERE definition ILIKE '%secret s.%';
----
0

