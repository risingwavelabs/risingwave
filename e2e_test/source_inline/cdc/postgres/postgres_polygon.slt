    ours.id,
    ours.shape,
    upstream.upstream_text,
    ours.shape is not distinct from upstream.upstream_text
from test_polygon_auto_discovery_rw as ours
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text as upstream_text from public.test_polygon_auto_discovery where id = 1'
    )
) as upstream(id, upstream_text) on ours.id = upstream.id
where ours.id = 1;
----
1 ((10,10),(20,10),(20,20),(10,20)) ((10,10),(20,10),(20,20),(10,20)) t

