        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text as upstream_text from public.test_polygon where id = 6'
    )
) as upstream(id, upstream_text) on ours.id = upstream.id
where ours.id = 6;
----
toast-original t

