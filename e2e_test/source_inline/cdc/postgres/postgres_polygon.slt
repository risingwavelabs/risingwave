# Test: incremental INSERT

# Insert non-NULL and NULL scalar polygon values.
system ok
psql -v ON_ERROR_STOP=1 -c "
    INSERT INTO public.test_polygon VALUES
        (3, 'inserted', polygon '((15.5,0.125),(20.25,-10.5))'),
        (4, 'null-shape', NULL);
"

query ITTTT retry 10 backoff 1s
select
    ours.id,
    ours.name,
    ours.shape,
    upstream.upstream_text,
    ours.shape is not distinct from upstream.upstream_text
from test_polygon as ours
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text as upstream_text from public.test_polygon where id in (3, 4)'
    )
) as upstream(id, upstream_text) on ours.id = upstream.id
where ours.id in (3, 4)
order by ours.id;
----
3 inserted ((15.5,0.125),(20.25,-10.5)) ((15.5,0.125),(20.25,-10.5)) t
4 null-shape NULL NULL t

# Insert a polygon array with a NULL element and a NULL polygon array.
system ok
psql -v ON_ERROR_STOP=1 -c "
    INSERT INTO public.test_polygon_array VALUES
        (
            2,
            'inserted-shapes',
            ARRAY[
                polygon '((6,6),(7,6),(7,7),(6,7))',
                NULL
            ]::polygon[]
        ),
        (3, 'null-shapes', NULL);
"

query ITTTT retry 10 backoff 1s
select
    ours.id,
    ours.name,
    ours.shapes[1],
    upstream.upstream_text_1,
    (ours.shapes is null) = upstream.upstream_array_is_null
        and (ours.shapes[1] is not distinct from upstream.upstream_text_1)
        and (ours.shapes[2] is null) = upstream.upstream_element_is_null
from test_polygon_array as ours
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shapes is null as upstream_array_is_null, shapes[1]::text as upstream_text_1, shapes[2] is null as upstream_element_is_null from public.test_polygon_array where id in (2, 3)'
    )
) as upstream(id, upstream_array_is_null, upstream_text_1, upstream_element_is_null)
on ours.id = upstream.id
where ours.id in (2, 3)
order by ours.id;
----
2 inserted-shapes ((6,6),(7,6),(7,7),(6,7)) ((6,6),(7,6),(7,7),(6,7)) t
3 null-shapes NULL NULL t

