control substitution on

# PostgreSQL polygon CDC test.
#
# This file is self-contained and covers:
# - manual schema creation and automatic schema discovery for polygon and polygon[];
# - snapshot backfill and incremental INSERT, UPDATE, and DELETE events;
# - automatic schema changes adding polygon and polygon[] columns.

statement ok
drop table if exists rw_polygon_manual;

statement ok
drop table if exists rw_polygon_auto;

statement ok
drop table if exists rw_polygon_schema_change;

statement ok
drop source if exists polygon_source cascade;

system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot';
    DROP TABLE IF EXISTS public.upstream_polygon_values CASCADE;
    DROP TABLE IF EXISTS public.upstream_polygon_schema_change CASCADE;
    CREATE TABLE public.upstream_polygon_values (
        id int PRIMARY KEY,
        name varchar,
        shape polygon,
        shapes polygon[]
    );
    ALTER TABLE public.upstream_polygon_values
        ALTER COLUMN shape SET STORAGE EXTERNAL;
    INSERT INTO public.upstream_polygon_values VALUES
        (
            1,
            'backfill',
            polygon '((0,0),(10,0),(10,10),(0,10))',
            ARRAY[
                polygon '((1,1),(2,1),(2,2),(1,2))',
                polygon '((3,3),(4,3),(4,4),(3,4))'
            ]::polygon[]
        ),
        (2, 'nulls', NULL, NULL);
    CREATE TABLE public.upstream_polygon_schema_change (
        id int PRIMARY KEY,
        name varchar
    );
"

statement ok
create source polygon_source with (
  connector = 'postgres-cdc',
  hostname = '${PGHOST:localhost}',
  port = '${PGPORT:5432}',
  username = '${PGUSER:$USER}',
  password = '${PGPASSWORD:}',
  database.name = '${PGDATABASE:postgres}',
  schema.name = 'public',
  slot.name = 'polygon_issue_25517_slot',
  auto.schema.change = 'true',
  debezium.include.unknown.datatypes = 'true'
);

statement ok
create table rw_polygon_manual (
    id int primary key,
    name varchar,
    shape varchar,
    shapes varchar[]
) from polygon_source table 'public.upstream_polygon_values';

# Initial schema discovery must derive the
# polygon -> varchar and
# polygon[] -> varchar[] mappings.
statement ok
create table rw_polygon_auto (*)
from polygon_source table 'public.upstream_polygon_values';

query TT rowsort retry 10 backoff 1s
select c.name, c.data_type
from rw_catalog.rw_columns c
join rw_catalog.rw_tables t on c.relation_id = t.id
where t.name = 'rw_polygon_auto'
  and c.name in ('shape', 'shapes');
----
shape character varying
shapes character varying[]

# Check for backfilled rows
query IT?T?T? retry 10 backoff 1s
select
    auto.id,
    auto.shape,
    auto.shape is not distinct from upstream.shape_text,
    auto.shapes[1],
    auto.shapes[1] is not distinct from upstream.shape_1_text,
    auto.shapes[2],
    auto.shapes[2] is not distinct from upstream.shape_2_text
from rw_polygon_auto auto
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text, shapes[1]::text, shapes[2]::text from public.upstream_polygon_values order by id'
    )
) as upstream(id, shape_text, shape_1_text, shape_2_text) using (id)
order by auto.id;
----
1 ((0,0),(10,0),(10,10),(0,10)) t ((1,1),(2,1),(2,2),(1,2)) t ((3,3),(4,3),(4,4),(3,4)) t
2 NULL t NULL t NULL t

# Incremental INSERT, including a NULL array element.
system ok
psql -c "
    INSERT INTO public.upstream_polygon_values VALUES (
        3,
        'inserted',
        polygon '((15.5,0.125),(20.25,-10.5))',
        ARRAY[
            polygon '((6,6),(7,6),(7,7),(6,7))',
            NULL
        ]::polygon[]
    );
"

query IT?T?T? retry 10 backoff 1s
select
    auto.id,
    auto.shape,
    auto.shape is not distinct from upstream.shape_text,
    auto.shapes[1],
    auto.shapes[1] is not distinct from upstream.shape_1_text,
    auto.shapes[2],
    auto.shapes[2] is not distinct from upstream.shape_2_text
from rw_polygon_auto auto
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text, shapes[1]::text, shapes[2]::text from public.upstream_polygon_values where id = 3'
    )
) as upstream(id, shape_text, shape_1_text, shape_2_text) using (id);
----
3 ((15.5,0.125),(20.25,-10.5)) t ((6,6),(7,6),(7,7),(6,7)) t NULL t

# An unchanged out-of-line polygon is represented internally by Debezium as a
# bare Object sentinel. The custom converter must turn it into RisingWave's
# unavailable-value placeholder so the stream executor preserves the old value.
system ok
psql -v ON_ERROR_STOP=1 -c "
    INSERT INTO public.upstream_polygon_values (id, name, shape)
    SELECT
        4,
        'toast-original',
        ('(' || string_agg(format('(%s,%s)', i, (i * 7919) % 104729), ',') || ')')::polygon
    FROM generate_series(1, 1000) AS points(i);
"

query IT retry 10 backoff 1s
select
    auto.name,
    auto.shape is not distinct from upstream.shape_text
from rw_polygon_auto auto
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text from public.upstream_polygon_values where id = 4'
    )
) as upstream(id, shape_text) using (id);
----
toast-original t

system ok
psql -v ON_ERROR_STOP=1 -c "
    UPDATE public.upstream_polygon_values
    SET name = 'toast-name-updated'
    WHERE id = 4;
"

query IT retry 10 backoff 1s
select
    auto.name,
    auto.shape is not distinct from upstream.shape_text
from rw_polygon_auto auto
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text from public.upstream_polygon_values where id = 4'
    )
) as upstream(id, shape_text) using (id);
----
toast-name-updated t

# Incremental UPDATE of both the scalar and array values.
system ok
psql -c "
    UPDATE public.upstream_polygon_values
    SET name = 'updated',
        shape = polygon '((20.5,20.5),(30.5,20.5),(30.5,30.5),(20.5,30.5))',
        shapes = ARRAY[
            polygon '((21,21),(22,21),(22,22),(21,22))',
            polygon '((23,23),(24,23),(24,24),(23,24))'
        ]::polygon[]
    WHERE id = 1;
"

query IT?T?T? retry 10 backoff 1s
select
    auto.id,
    auto.shape,
    auto.shape is not distinct from upstream.shape_text,
    auto.shapes[1],
    auto.shapes[1] is not distinct from upstream.shape_1_text,
    auto.shapes[2],
    auto.shapes[2] is not distinct from upstream.shape_2_text
from rw_polygon_auto auto
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text, shapes[1]::text, shapes[2]::text from public.upstream_polygon_values where id = 1'
    )
) as upstream(id, shape_text, shape_1_text, shape_2_text) using (id);
----
1 ((20.5,20.5),(30.5,20.5),(30.5,30.5),(20.5,30.5)) t ((21,21),(22,21),(22,22),(21,22)) t ((23,23),(24,23),(24,24),(23,24)) t

# DELETE must remove the converted row.
system ok
psql -c "DELETE FROM public.upstream_polygon_values WHERE id = 1;"

query I retry 10 backoff 1s
select count(*) from rw_polygon_auto where id = 1;
----
0

# Start with an ordinary table, then add scalar and array polygon columns.
statement ok
create table rw_polygon_schema_change (*)
from polygon_source table 'public.upstream_polygon_schema_change';

system ok
psql -c "
    ALTER TABLE public.upstream_polygon_schema_change
        ADD COLUMN shape polygon,
        ADD COLUMN shapes polygon[];
"

query TT rowsort retry 20 backoff 1s
select c.name, c.data_type
from rw_catalog.rw_columns c
join rw_catalog.rw_tables t on c.relation_id = t.id
where t.name = 'rw_polygon_schema_change'
  and c.name in ('shape', 'shapes');
----
shape character varying
shapes character varying[]

statement ok
drop table rw_polygon_manual;

statement ok
drop table rw_polygon_auto;

statement ok
drop table rw_polygon_schema_change;

statement ok
drop source polygon_source;

system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot';
    DROP TABLE IF EXISTS public.upstream_polygon_values CASCADE;
    DROP TABLE IF EXISTS public.upstream_polygon_schema_change CASCADE;
"
