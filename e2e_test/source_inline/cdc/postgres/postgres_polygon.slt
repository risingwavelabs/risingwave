# Test: preserve an unchanged TOASTed polygon
system ok
psql -v ON_ERROR_STOP=1 -c "
    ALTER TABLE public.test_polygon ALTER COLUMN shape SET STORAGE EXTERNAL;
    INSERT INTO public.test_polygon (id, name, shape)
    SELECT
        6,
        'toast-original',
        ('(' || string_agg(format('(%s,%s)', i, (i * 7919) % 104729), ',') || ')')::polygon
    FROM generate_series(1, 1000) AS points(i);
"

query IT retry 10 backoff 1s
select
    ours.name,
    ours.shape is not distinct from upstream.upstream_text
from test_polygon as ours
join (
