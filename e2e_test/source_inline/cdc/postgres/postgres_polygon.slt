control substitution on

# PostgreSQL polygon type CDC test

# Shared setup
statement ok
drop source if exists polygon_source cascade;

system ok
psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot';
"

statement ok
create source polygon_source with (
  connector = 'postgres-cdc',
  hostname = '${PGHOST:localhost}',
  port = '${PGPORT:5432}',
  username = '${PGUSER:$USER}',
  password = '${PGPASSWORD:}',
  database.name = '${PGDATABASE:postgres}',
  schema.name = 'public',
  slot.name = 'polygon_issue_25517_slot',
  auto.schema.change = 'true',
  debezium.include.unknown.datatypes = 'true'
);

# Test: accept correct explicit schemas

# A scalar polygon maps to varchar and backfill preserves PostgreSQL's text representation.
system ok
psql -v ON_ERROR_STOP=1 -c "
    DROP TABLE IF EXISTS public.test_polygon CASCADE;
    CREATE TABLE public.test_polygon (
        id int PRIMARY KEY,
        name varchar,
        shape polygon
    );
    INSERT INTO public.test_polygon VALUES
        (1, 'square', polygon '((0,0),(10,0),(10,10),(0,10))'),
        (2, 'triangle', polygon '((1,1),(5,1),(3,4))');
"

statement ok
drop table if exists test_polygon;

statement ok
create table test_polygon (
    id int primary key,
    name varchar,
    shape varchar
) from polygon_source table 'public.test_polygon';

query T
select c.data_type
from rw_catalog.rw_columns c
join rw_catalog.rw_tables t on c.relation_id = t.id
where t.name = 'test_polygon' and c.name = 'shape';
----
character varying

query ITTT retry 10 backoff 1s
select
    ours.id,
    ours.shape,
    upstream.upstream_text,
    ours.shape is not distinct from upstream.upstream_text
from test_polygon as ours
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shape::text as upstream_text from public.test_polygon'
    )
) as upstream(id, upstream_text) on ours.id = upstream.id
order by ours.id;
----
1 ((0,0),(10,0),(10,10),(0,10)) ((0,0),(10,0),(10,10),(0,10)) t
2 ((1,1),(5,1),(3,4)) ((1,1),(5,1),(3,4)) t

# Polygon arrays map to varchar[] and backfill preserves each element's text representation.
system ok
psql -v ON_ERROR_STOP=1 -c "
    DROP TABLE IF EXISTS public.test_polygon_array CASCADE;
    CREATE TABLE public.test_polygon_array (
        id int PRIMARY KEY,
        name varchar,
        shapes polygon[]
    );
    INSERT INTO public.test_polygon_array VALUES
        (
            1,
            'initial-shapes',
            ARRAY[
                polygon '((1,1),(2,1),(2,2),(1,2))',
                polygon '((3,3),(4,3),(4,4),(3,4))'
            ]::polygon[]
        );
"

statement ok
drop table if exists test_polygon_array;

statement ok
create table test_polygon_array (
    id int primary key,
    name varchar,
    shapes varchar[]
) from polygon_source table 'public.test_polygon_array';

query T
select c.data_type
from rw_catalog.rw_columns c
join rw_catalog.rw_tables t on c.relation_id = t.id
where t.name = 'test_polygon_array' and c.name = 'shapes';
----
character varying[]

query ITTTTTTT retry 10 backoff 1s
select
    ours.id,
    ours.name,
    ours.shapes[1],
    upstream.upstream_text_1,
    ours.shapes[1] is not distinct from upstream.upstream_text_1,
    ours.shapes[2],
    upstream.upstream_text_2,
    ours.shapes[2] is not distinct from upstream.upstream_text_2
from test_polygon_array as ours
join (
    select * from postgres_query(
        '${PGHOST:localhost}',
        '${PGPORT:5432}',
        '${PGUSER:$USER}',
        '${PGPASSWORD:}',
        '${PGDATABASE:postgres}',
        'select id, shapes[1]::text as upstream_text_1, shapes[2]::text as upstream_text_2 from public.test_polygon_array where id = 1'
    )
) as upstream(id, upstream_text_1, upstream_text_2) on ours.id = upstream.id
where ours.id = 1;
----
1 initial-shapes ((1,1),(2,1),(2,2),(1,2)) ((1,1),(2,1),(2,2),(1,2)) t ((3,3),(4,3),(4,4),(3,4)) ((3,3),(4,3),(4,4),(3,4)) t

# Test: reject an incorrect explicit scalar schema
system ok
psql -v ON_ERROR_STOP=1 -c "
    DROP TABLE IF EXISTS public.test_polygon_invalid_mapping_upstream CASCADE;
    CREATE TABLE public.test_polygon_invalid_mapping_upstream (
        id int PRIMARY KEY,
        name varchar,
        shape polygon
    );
"

statement ok
drop table if exists test_polygon_invalid_mapping;

statement error Incompatible data type of column shape
create table test_polygon_invalid_mapping (
    id int primary key,
    name varchar,
    shape integer
) from polygon_source table 'public.test_polygon_invalid_mapping_upstream';

