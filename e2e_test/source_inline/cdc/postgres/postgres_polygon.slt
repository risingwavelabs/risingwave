# Teardown
statement ok
drop table if exists test_polygon;

statement ok
drop table if exists test_polygon_array;

statement ok
drop table if exists test_polygon_auto_discovery_rw;

statement ok
drop table if exists test_polygon_array_auto_discovery_rw;

statement ok
drop table if exists test_polygon_schema_change_rw;

statement ok
drop source if exists polygon_source;

system ok
psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name)
    FROM pg_replication_slots
    WHERE slot_name = 'polygon_issue_25517_slot';
    DROP TABLE IF EXISTS public.test_polygon CASCADE;
    DROP TABLE IF EXISTS public.test_polygon_array CASCADE;
    DROP TABLE IF EXISTS public.test_polygon_invalid_mapping_upstream CASCADE;
    DROP TABLE IF EXISTS public.test_polygon_auto_discovery CASCADE;
    DROP TABLE IF EXISTS public.test_polygon_array_auto_discovery CASCADE;
