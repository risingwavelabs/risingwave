# Test: automatic schema discovery maps polygon correctly

# A scalar polygon is discovered as varchar and backfill preserves its text representation.
system ok
psql -v ON_ERROR_STOP=1 -c "
    DROP TABLE IF EXISTS public.test_polygon_auto_discovery CASCADE;
    CREATE TABLE public.test_polygon_auto_discovery (
        id int PRIMARY KEY,
        shape polygon
    );
    INSERT INTO public.test_polygon_auto_discovery VALUES
        (1, polygon '((10,10),(20,10),(20,20),(10,20))');
"

statement ok
drop table if exists test_polygon_auto_discovery_rw;

statement ok
create table test_polygon_auto_discovery_rw (*)
from polygon_source table 'public.test_polygon_auto_discovery';

query T retry 10 backoff 1s
select c.data_type
from rw_catalog.rw_columns c
join rw_catalog.rw_tables t on c.relation_id = t.id
where t.name = 'test_polygon_auto_discovery_rw' and c.name = 'shape';
----
character varying

query ITTT retry 10 backoff 1s
