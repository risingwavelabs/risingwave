# Exercise live credential rotation during both serial and parallel CDC snapshots.
# Requires password authentication, as configured by the CDC CI PostgreSQL service.
# A trust-authenticated server must fail this test rather than hide stale credentials.
control substitution on

statement ok
DROP SOURCE IF EXISTS pg_rotation_source CASCADE;

system ok
psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid) FROM pg_replication_slots
    WHERE slot_name = 'pg_rotation_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots
    WHERE slot_name = 'pg_rotation_slot';
    DROP PUBLICATION IF EXISTS pg_rotation_pub;
    DROP SCHEMA IF EXISTS rw_cdc_rotation CASCADE;
    DROP ROLE IF EXISTS rw_cdc_rotation_user;
    CREATE ROLE rw_cdc_rotation_user LOGIN REPLICATION PASSWORD 'rw_rotation_old';
    CREATE SCHEMA rw_cdc_rotation;
    CREATE TABLE rw_cdc_rotation.orders (id INT PRIMARY KEY, value INT);
    INSERT INTO rw_cdc_rotation.orders SELECT g, g * 10 FROM generate_series(1, 10000) g;
    GRANT USAGE ON SCHEMA rw_cdc_rotation TO rw_cdc_rotation_user;
    GRANT SELECT ON rw_cdc_rotation.orders TO rw_cdc_rotation_user;
    CREATE PUBLICATION pg_rotation_pub FOR TABLE rw_cdc_rotation.orders;
"

statement ok
CREATE SOURCE pg_rotation_source WITH (
    connector = 'postgres-cdc',
    hostname = '${PGHOST:localhost}',
    port = '${PGPORT:5432}',
    username = 'rw_cdc_rotation_user',
    password = 'rw_rotation_old',
    database.name = '${PGDATABASE:postgres}',
    schema.name = 'rw_cdc_rotation',
    slot.name = 'pg_rotation_slot',
    publication.name = 'pg_rotation_pub'
);

# Keep both snapshots unfinished until the password changes. Assert actual progress,
# rather than relying on a sleep or only testing tables whose snapshots already ended.
statement ok
SET backfill_rate_limit = 1;

statement ok
CREATE TABLE pg_rotation_serial (*) WITH (
    snapshot.batch_size = '100',
    backfill.parallelism = '0'
) FROM pg_rotation_source TABLE 'rw_cdc_rotation.orders';

statement ok
CREATE TABLE pg_rotation_parallel (*) WITH (
    snapshot.batch_size = '100',
    backfill.parallelism = '2',
    backfill.num_rows_per_split = '1000'
) FROM pg_rotation_source TABLE 'rw_cdc_rotation.orders';

statement ok
SET backfill_rate_limit = DEFAULT;

query BB retry 60 backoff 1s
SELECT
    (SELECT count(*) > 0 AND count(*) < 10000 FROM pg_rotation_serial),
    (SELECT count(*) > 0 AND count(*) < 10000 FROM pg_rotation_parallel);
----
t t

# Password changes do not invalidate existing PostgreSQL sessions. Close only this
# test user's native snapshot readers so stale credentials cannot keep working on
# an old connection. Leave the shared Debezium replication connection running.
system ok
psql -v ON_ERROR_STOP=1 -c "ALTER ROLE rw_cdc_rotation_user PASSWORD 'rw_rotation_new';"
psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(pid) FROM pg_stat_activity
    WHERE usename = 'rw_cdc_rotation_user'
      AND application_name LIKE 'risingwave-postgres-source-reader-%';
    UPDATE rw_cdc_rotation.orders SET value = -10 WHERE id = 1;
    DELETE FROM rw_cdc_rotation.orders WHERE id = 2;
    INSERT INTO rw_cdc_rotation.orders VALUES (10001, 100010);
"

# Verify that the old password really stopped working (in particular, reject trust
# authentication), and that the new password can read the upstream table.
system ok
if PGUSER=rw_cdc_rotation_user PGPASSWORD=rw_rotation_old psql -h "${PGHOST:-localhost}" -v ON_ERROR_STOP=1 -c 'SELECT 1' >/dev/null 2>&1; then
    echo 'Old password still works: this test requires PostgreSQL password authentication' >&2
    exit 1
fi
PGUSER=rw_cdc_rotation_user PGPASSWORD=rw_rotation_new psql -h "${PGHOST:-localhost}" -v ON_ERROR_STOP=1 -c 'SELECT count(*) FROM rw_cdc_rotation.orders' >/dev/null

# Set the resumed rate before the connector-change barrier. V2 applies a new rate
# at its next snapshot attempt, which the password change must trigger.
statement ok
ALTER TABLE pg_rotation_serial SET backfill_rate_limit = DEFAULT;

statement ok
ALTER TABLE pg_rotation_parallel SET backfill_rate_limit = DEFAULT;

statement ok
ALTER SOURCE pg_rotation_source CONNECTOR WITH (password = 'rw_rotation_new');

# No RECOVER: the existing executors must rebuild their readers with the new
# password. Check all snapshot rows and the CDC updates buffered during backfill.
query TIII rowsort retry 60 backoff 1s
SELECT 'serial', count(*), sum(id), sum(value) FROM pg_rotation_serial
UNION ALL
SELECT 'parallel', count(*), sum(id), sum(value) FROM pg_rotation_parallel;
----
parallel 10000 50014999 500149970
serial 10000 50014999 500149970

query TII rowsort
SELECT 'serial', id, value FROM pg_rotation_serial WHERE id IN (1, 2, 10001)
UNION ALL
SELECT 'parallel', id, value FROM pg_rotation_parallel WHERE id IN (1, 2, 10001);
----
parallel 1 -10
parallel 10001 100010
serial 1 -10
serial 10001 100010

# Both tables must also keep consuming CDC after finishing their snapshots.
system ok
psql -v ON_ERROR_STOP=1 -c "
    DELETE FROM rw_cdc_rotation.orders WHERE id = 3;
    UPDATE rw_cdc_rotation.orders SET value = 4000 WHERE id = 4;
    INSERT INTO rw_cdc_rotation.orders VALUES (10002, 100020);
"

query TIII rowsort retry 60 backoff 1s
SELECT 'serial', count(*), sum(id), sum(value) FROM pg_rotation_serial
UNION ALL
SELECT 'parallel', count(*), sum(id), sum(value) FROM pg_rotation_parallel;
----
parallel 10000 50024998 500253920
serial 10000 50024998 500253920

statement ok
DROP SOURCE pg_rotation_source CASCADE;

system ok
psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid) FROM pg_replication_slots
    WHERE slot_name = 'pg_rotation_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots
    WHERE slot_name = 'pg_rotation_slot';
    DROP PUBLICATION IF EXISTS pg_rotation_pub;
    DROP SCHEMA IF EXISTS rw_cdc_rotation CASCADE;
    DROP ROLE IF EXISTS rw_cdc_rotation_user;
"
