control substitution on

system ok
sqlcmd -C -d master -Q "IF DB_ID('dotted_name_db') IS NOT NULL BEGIN ALTER DATABASE dotted_name_db SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE dotted_name_db; END; CREATE DATABASE dotted_name_db;" -b

system ok
sqlcmd -C -d dotted_name_db -i e2e_test/source_inline/cdc/sql_server/sql_server_dotted_table_name_prepare.sql -b

statement ok
create source mssql_dotted_name_source with (
    connector = 'sqlserver-cdc',
    hostname = '${SQLCMDSERVER:sqlserver-server}',
    port = '${SQLCMDPORT:1433}',
    username = '${SQLCMDUSER:SA}',
    password = '${SQLCMDPASSWORD}',
    database.name = 'dotted_name_db',
);

control substitution off

statement ok
create table rw_dotted (id int primary key, v varchar)
include table_name as upstream_table
from mssql_dotted_name_source table 'dbo.[a.b]';

statement ok
create table rw_dotted_with_database (id int primary key, v varchar)
from mssql_dotted_name_source table '[dotted_name_db].dbo.[a.b]';

statement ok
create table rw_decoy (id int primary key, v varchar)
from mssql_dotted_name_source table 'a.b';

statement ok
create table rw_plain (id int primary key, v varchar)
from mssql_dotted_name_source table 'dbo.plain';

system ok
sqlcmd -C -d dotted_name_db -i e2e_test/source_inline/cdc/sql_server/sql_server_dotted_table_name_insert.sql -b

query TIT retry 60 backoff 1s
select 'dotted', id, v from rw_dotted
union all select 'dotted_with_database', * from rw_dotted_with_database
union all select 'decoy', * from rw_decoy
union all select 'plain', * from rw_plain
order by 1, 2;
----
decoy 2 decoy
dotted 1 dotted
dotted_with_database 1 dotted
plain 3 plain

query IT
select id, upstream_table from rw_dotted;
----
1 a.b

statement ok
drop source mssql_dotted_name_source cascade;

system ok
sqlcmd -C -d master -Q "IF DB_ID('dotted_name_db') IS NOT NULL BEGIN ALTER DATABASE dotted_name_db SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE dotted_name_db; END;" -b
