control substitution on

statement ok
drop source if exists s_mysql_snapshot_charset cascade;

# The upstream server charset is not utf8mb4 (CI runs MySQL with `utf8`, i.e. utf8mb3).
# Snapshot connections are reset whenever they return to the pool, which drops the session
# charset back to the server default, so emoji used to come back as `?`.
system ok
mysql --default-character-set=utf8mb4 -e "
    DROP USER IF EXISTS 'snapshot_charset_cdc'@'%';
    DROP DATABASE IF EXISTS mysql_snapshot_charset;
    CREATE DATABASE mysql_snapshot_charset;
    CREATE USER 'snapshot_charset_cdc'@'%' IDENTIFIED BY 'snapshot_charset_cdc_pwd';
    GRANT SELECT, RELOAD, SHOW DATABASES, REPLICATION SLAVE, REPLICATION CLIENT ON *.* TO 'snapshot_charset_cdc'@'%';
    USE mysql_snapshot_charset;
    CREATE TABLE upstream_table (
        name VARCHAR(32) PRIMARY KEY,
        note VARCHAR(32)
    ) DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_bin;
    INSERT INTO upstream_table VALUES
        ('a😀b', 'backfill 😀'),
        ('plain', 'backfill'),
        ('Åre', 'backfill Å');
"

statement ok
create source s_mysql_snapshot_charset with (
  ${RISEDEV_MYSQL_WITH_OPTIONS_COMMON},
  username = 'snapshot_charset_cdc',
  password = 'snapshot_charset_cdc_pwd',
  database.name = 'mysql_snapshot_charset'
);

# One row per snapshot page, so every page resumes from a non-ASCII primary key.
statement ok
create table rw_mysql_snapshot_charset (
    name varchar primary key,
    note varchar
) with (
    snapshot.batch_size = '1'
) from s_mysql_snapshot_charset table 'mysql_snapshot_charset.upstream_table';

query TT retry 10 backoff 1s
select name, note from rw_mysql_snapshot_charset order by name;
----
a😀b backfill 😀
plain backfill
Åre backfill Å

system ok
mysql --default-character-set=utf8mb4 -e "
    USE mysql_snapshot_charset;
    INSERT INTO upstream_table VALUES ('b😀c', 'stream 😀');
"

query TT retry 10 backoff 1s
select name, note from rw_mysql_snapshot_charset order by name;
----
a😀b backfill 😀
b😀c stream 😀
plain backfill
Åre backfill Å

statement ok
drop source s_mysql_snapshot_charset cascade;

system ok
mysql -e "
    DROP DATABASE IF EXISTS mysql_snapshot_charset;
    DROP USER IF EXISTS 'snapshot_charset_cdc'@'%';
"
