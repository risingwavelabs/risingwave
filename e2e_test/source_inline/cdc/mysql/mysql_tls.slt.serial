# MySQL TLS fixture: ci/mysql-tls and ci/docker-compose.yml.
# RECOVER requires serial execution. Every positive case tests snapshot, live rows, and resume.
control substitution on

system ok
mysql --protocol=tcp --host="${MYSQL_TLS_HOST}" --port="${MYSQL_TLS_PORT}" --user=root --password=123456 --ssl-mode=VERIFY_IDENTITY --ssl-ca="${MYSQL_TLS_CERT_DIR}/ca.pem" -e "DROP DATABASE IF EXISTS rw_mysql_tls; CREATE DATABASE rw_mysql_tls; CREATE TABLE rw_mysql_tls.t (id INT PRIMARY KEY, phase VARCHAR(20)); INSERT INTO rw_mysql_tls.t VALUES (1, 'snapshot');"

system ok
mysql --protocol=tcp --host="${MYSQL_NO_TLS_HOST}" --port="${MYSQL_NO_TLS_PORT}" --user=root --password=123456 --ssl-mode=DISABLED --get-server-public-key -e "DROP DATABASE IF EXISTS rw_mysql_tls_fallback; CREATE DATABASE rw_mysql_tls_fallback; CREATE TABLE rw_mysql_tls_fallback.t (id INT PRIMARY KEY, phase VARCHAR(20)); INSERT INTO rw_mysql_tls_fallback.t VALUES (1, 'snapshot');"

system ok
mysql -e "DROP DATABASE IF EXISTS rw_mysql_tls_plain; CREATE DATABASE rw_mysql_tls_plain; CREATE TABLE rw_mysql_tls_plain.t (id INT PRIMARY KEY, phase VARCHAR(20)); INSERT INTO rw_mysql_tls_plain.t VALUES (1, 'snapshot');"

statement ok
CREATE SOURCE s_mysql_tls_disabled WITH (
  ${RISEDEV_MYSQL_WITH_OPTIONS_COMMON},
  username = '${RISEDEV_MYSQL_USER}', password = '${MYSQL_PWD}',
  database.name = 'rw_mysql_tls_plain', ssl.mode = 'disabled'
);

statement ok
CREATE TABLE mysql_tls_disabled (*) FROM s_mysql_tls_disabled TABLE 'rw_mysql_tls_plain.t';

query IT retry 30 backoff 1s
SELECT * FROM mysql_tls_disabled;
----
1 snapshot

statement ok
CREATE SOURCE s_mysql_tls_preferred WITH (
  connector = 'mysql-cdc', hostname = '${MYSQL_TLS_HOST}', port = '${MYSQL_TLS_PORT}',
  username = 'root', password = '123456', database.name = 'rw_mysql_tls',
  ssl.mode = 'preferred'
);

statement ok
CREATE TABLE mysql_tls_preferred (*) FROM s_mysql_tls_preferred TABLE 'rw_mysql_tls.t';

query IT retry 30 backoff 1s
SELECT * FROM mysql_tls_preferred;
----
1 snapshot

statement ok
CREATE SOURCE s_mysql_tls_preferred_fallback WITH (
  connector = 'mysql-cdc', hostname = '${MYSQL_NO_TLS_HOST}', port = '${MYSQL_NO_TLS_PORT}',
  username = 'root', password = '123456', database.name = 'rw_mysql_tls_fallback',
  debezium.database.sslmode = 'prefer'
);

statement ok
CREATE TABLE mysql_tls_preferred_fallback (*) FROM s_mysql_tls_preferred_fallback TABLE 'rw_mysql_tls_fallback.t';

