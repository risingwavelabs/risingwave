# Monitoring must also connect using the configured TLS mode and CA.
system ok
python3 e2e_test/source_inline/cdc/mysql/check_tls_monitor.py

system ok
mysql --protocol=tcp --host="${MYSQL_TLS_HOST}" --port="${MYSQL_TLS_PORT}" --user=root --password=123456 --ssl-mode=VERIFY_IDENTITY --ssl-ca="${MYSQL_TLS_CERT_DIR}/ca.pem" -e "INSERT INTO rw_mysql_tls.t VALUES (2, 'streaming');"

system ok
mysql -e "INSERT INTO rw_mysql_tls_plain.t VALUES (2, 'streaming');"

system ok
mysql --protocol=tcp --host="${MYSQL_NO_TLS_HOST}" --port="${MYSQL_NO_TLS_PORT}" --user=root --password=123456 --ssl-mode=DISABLED --get-server-public-key -e "INSERT INTO rw_mysql_tls_fallback.t VALUES (2, 'streaming');"

