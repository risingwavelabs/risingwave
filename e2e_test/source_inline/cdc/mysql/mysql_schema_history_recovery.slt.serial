# Without GTIDs, schema history recovery must compare binlog coordinates. Here the committed
# offset's event time is earlier than the wall-clock time of the schema snapshot, as when an
# upstream replays old events, and the source must still know its tables after recovery.

control substitution on

system ok
mysql -e "
    DROP DATABASE IF EXISTS mysql_history_recovery;
    CREATE DATABASE mysql_history_recovery;
    USE mysql_history_recovery;
    CREATE TABLE t (id INT PRIMARY KEY, v VARCHAR(20));
    INSERT INTO t VALUES (1, 'snapshot');
"

statement ok
create source s_history_recovery with (
  ${RISEDEV_MYSQL_WITH_OPTIONS_COMMON},
  username = '${RISEDEV_MYSQL_USER}',
  password = '${MYSQL_PWD}',
  database.name = 'mysql_history_recovery'
);

sleep 2s

statement ok
create table t_history_recovery (id int primary key, v varchar)
from s_history_recovery table 'mysql_history_recovery.t';

query IT retry 10 backoff 1s
select id, v from t_history_recovery order by id;
----
1 snapshot

system ok
mysql -e "
    SET timestamp = UNIX_TIMESTAMP() - 3600;
    INSERT INTO mysql_history_recovery.t VALUES (2, 'old event time');
"

query IT retry 10 backoff 1s
select id, v from t_history_recovery order by id;
----
1 snapshot
2 old event time

statement ok
flush;

statement ok
recover;

sleep 2s

system ok
mysql -e "
    INSERT INTO mysql_history_recovery.t VALUES (3, 'after recovery');
"

query IT retry 30 backoff 1s
select id, v from t_history_recovery order by id;
----
1 snapshot
2 old event time
3 after recovery

statement ok
drop table t_history_recovery;

statement ok
drop source s_history_recovery cascade;

system ok
mysql -e "
    DROP DATABASE IF EXISTS mysql_history_recovery;
"
