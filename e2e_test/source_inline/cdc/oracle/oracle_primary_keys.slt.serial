system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import begin_tx, end_tx
begin_tx("oracle_pk_edge_dml", [
    "UPDATE APP.RW_PK_NUMBER_28_0 SET VALUE = 'max-updated' WHERE ID = 9999999999999999999999999999",
    "UPDATE APP.RW_PK_NUMBER_28_28 SET VALUE = 'max-updated' WHERE ID = 0.9999999999999999999999999999",
    "UPDATE APP.RW_PK_NUMBER_27_NEG1 SET VALUE = 'max-updated' WHERE ID = 9999999999999999999999999990",
    "UPDATE APP.RW_PK_DATE SET VALUE = 'max-updated' "
    "WHERE ID = TO_DATE('2024-01-01 00:00:01', 'YYYY-MM-DD HH24:MI:SS')",
])
end_tx("oracle_pk_edge_dml")
PY

