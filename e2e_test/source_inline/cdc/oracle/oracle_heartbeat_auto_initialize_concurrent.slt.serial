system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py assert_seed C##RW_VALIDATOR

# A snapshot-completion heartbeat must change the sentinel even with concurrent shared sources.
system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py prepare seeded_oracle_hb

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py assert_seed C##RW_VALIDATOR --expected_value 7

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py create_sources_concurrently seeded_oracle_hb_source

statement ok
CREATE TABLE seeded_oracle_hb_1 (
    "ID" DECIMAL,
    "NAME" VARCHAR,
    PRIMARY KEY ("ID")
) FROM seeded_oracle_hb_source_1 TABLE 'APP.CUSTOMERS';

statement ok
