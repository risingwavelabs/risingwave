statement ok
DROP SOURCE IF EXISTS seeded_oracle_hb_source_2 CASCADE;

# Concurrent shared-source creation must converge when both initially observe a missing table.
system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py prepare missing_oracle_hb

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py create_sources_concurrently missing_oracle_hb_source

statement ok
CREATE TABLE missing_oracle_hb_1 (
    "ID" DECIMAL,
    "NAME" VARCHAR,
    PRIMARY KEY ("ID")
) FROM missing_oracle_hb_source_1 TABLE 'APP.CUSTOMERS';

statement ok
CREATE TABLE missing_oracle_hb_2 (
    "ID" DECIMAL,
    "NAME" VARCHAR,
    PRIMARY KEY ("ID")
) FROM missing_oracle_hb_source_2 TABLE 'APP.CUSTOMERS';

query I retry 30 backoff 1s
SELECT count(*) FROM missing_oracle_hb_1;
----
1

query I retry 30 backoff 1s
SELECT count(*) FROM missing_oracle_hb_2;
----
1

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py assert_seed C##RW_VALIDATOR

statement ok
DROP TABLE missing_oracle_hb_1;

statement ok
DROP TABLE missing_oracle_hb_2;

statement ok
DROP SOURCE missing_oracle_hb_source_1 CASCADE;

statement ok
DROP SOURCE missing_oracle_hb_source_2 CASCADE;

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py assert_seed C##RW_VALIDATOR

# Compatible existing empty heartbeat tables must be seeded by concurrent shared sources.
system ok
