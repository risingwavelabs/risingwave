# Concurrent shared-source creation must converge when both initially observe a missing table.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls([
    "CREATE TABLE $TEST_ORACLE_SOURCE_SCHEMA.CUSTOMERS (ID NUMBER PRIMARY KEY, NAME VARCHAR2(100))",
    "ALTER TABLE $TEST_ORACLE_SOURCE_SCHEMA.CUSTOMERS ADD SUPPLEMENTAL LOG DATA (ALL) COLUMNS",
    "INSERT INTO $TEST_ORACLE_SOURCE_SCHEMA.CUSTOMERS (ID, NAME) VALUES (1, 'RisingWave')",
])
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_seed
execute_sqls([
    """CREATE SOURCE missing_oracle_hb_source_1 WITH (
        $TEST_ORACLE_WITH_OPTIONS_COMMON,
        schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
        heartbeat.table.name = '$TEST_ORACLE_USER.$TEST_ORACLE_HEARTBEAT_TABLE',
        heartbeat.table.auto.initialize = 'true'
    ) FORMAT PLAIN ENCODE JSON;""",
    """CREATE SOURCE missing_oracle_hb_source_2 WITH (
        $TEST_ORACLE_WITH_OPTIONS_COMMON,
        schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
        heartbeat.table.name = '$TEST_ORACLE_USER.$TEST_ORACLE_HEARTBEAT_TABLE',
        heartbeat.table.auto.initialize = 'true'
    ) FORMAT PLAIN ENCODE JSON;""",
],
    is_concurrent=True,
    after_sqls_hook=check_heartbeat_seed,
    after_sqls_hook_kwargs={"owner": "$TEST_ORACLE_USER"},
)
PY

statement ok
CREATE TABLE missing_oracle_hb_1 (
    "ID" DECIMAL,
    "NAME" VARCHAR,
    PRIMARY KEY ("ID")
) FROM missing_oracle_hb_source_1 TABLE 'APP.CUSTOMERS';

statement ok
CREATE TABLE missing_oracle_hb_2 (
    "ID" DECIMAL,
    "NAME" VARCHAR,
    PRIMARY KEY ("ID")
) FROM missing_oracle_hb_source_2 TABLE 'APP.CUSTOMERS';

query I retry 30 backoff 1s
SELECT count(*) FROM missing_oracle_hb_1;
----
1

query I retry 30 backoff 1s
SELECT count(*) FROM missing_oracle_hb_2;
----
1

statement ok
DROP TABLE missing_oracle_hb_1;

statement ok
DROP TABLE missing_oracle_hb_2;

statement ok
DROP SOURCE missing_oracle_hb_source_1 CASCADE;

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
