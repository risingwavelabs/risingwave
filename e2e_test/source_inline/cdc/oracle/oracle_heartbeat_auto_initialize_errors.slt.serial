include oracle_test_env.slt.part

statement ok
DROP SOURCE IF EXISTS missing_oracle_schema CASCADE;

statement ok
DROP SOURCE IF EXISTS missing_app_oracle_hb CASCADE;

statement ok
DROP SOURCE IF EXISTS empty_app_oracle_hb CASCADE;

statement ok
DROP SOURCE IF EXISTS seeded_app_oracle_hb CASCADE;

statement ok
DROP SOURCE IF EXISTS incompatible_oracle_hb CASCADE;

# Initialization must not create the Oracle user that owns a missing schema.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op, create_default_schema
# APP is the source schema; only the separate heartbeat owner must stay absent.
prepare(
    create_schema_hook=create_default_schema,
    create_heartbeat_tables_hook=no_op,
)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls([
    # Not creating this owner does not remove leftovers from earlier runs.
    "DROP USER IF EXISTS RW_MISSING_SCHEMA CASCADE",
])
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_creation_error, check_schema_missing
execute_sqls(["""
CREATE SOURCE missing_oracle_schema WITH (
    $TEST_ORACLE_WITH_OPTIONS_COMMON,
    schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
    heartbeat.table.name = 'RW_MISSING_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE',
    heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;
"""],
    after_sqls_hook=check_heartbeat_creation_error,
    after_sqls_hook_kwargs={
        "owner": "RW_MISSING_SCHEMA",
        "expected_message": "schema 'RW_MISSING_SCHEMA' does not exist",
        "after_error_check_hook": check_schema_missing,
        "after_error_check_hook_kwargs": {"owner": "RW_MISSING_SCHEMA"},
    },
)
PY

# APP exists, but CREATE SOURCE only permits heartbeat-table creation in the connector's schema.
# Without CREATE ANY TABLE, it cannot create APP.RW_HEARTBEAT.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_creation_error, check_heartbeat_missing
execute_sqls(["""
CREATE SOURCE missing_app_oracle_hb WITH (
    $TEST_ORACLE_WITH_OPTIONS_COMMON,
    schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
    heartbeat.table.name = '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE',
    heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;
"""],
    after_sqls_hook=check_heartbeat_creation_error,
    after_sqls_hook_kwargs={
        "owner": "$TEST_ORACLE_SOURCE_SCHEMA",
        "expected_message": "Failed to create Oracle heartbeat table '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE'",
        "after_error_check_hook": check_heartbeat_missing,
        "after_error_check_hook_kwargs": {"owner": "$TEST_ORACLE_SOURCE_SCHEMA"},
    },
)
PY

# A DBA-created empty table remains empty when the connector lacks INSERT permission.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls([
    "CREATE TABLE $TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE "
    "(ID NUMBER(1) PRIMARY KEY, HEARTBEAT NUMBER(1) NOT NULL)",
])
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_creation_error, check_heartbeat_empty
execute_sqls(["""
CREATE SOURCE empty_app_oracle_hb WITH (
    $TEST_ORACLE_WITH_OPTIONS_COMMON,
    schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
    heartbeat.table.name = '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE',
    heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;
"""],
    after_sqls_hook=check_heartbeat_creation_error,
    after_sqls_hook_kwargs={
        "owner": "$TEST_ORACLE_SOURCE_SCHEMA",
        "expected_message": "Failed to insert the seed row into Oracle heartbeat table '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE'",
        "create_table": False,
        "after_error_check_hook": check_heartbeat_empty,
        "after_error_check_hook_kwargs": {"owner": "$TEST_ORACLE_SOURCE_SCHEMA"},
    },
)
PY

# Once the table and seed row exist, runtime heartbeats require only UPDATE permission.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls([
    "CREATE TABLE $TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE "
    "(ID NUMBER(1) PRIMARY KEY, HEARTBEAT NUMBER(1) NOT NULL)",
    "INSERT INTO $TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE (ID, HEARTBEAT) VALUES (1, 7)",
])
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_creation_error, check_heartbeat_seed
execute_sqls(["""
CREATE SOURCE seeded_app_oracle_hb WITH (
    $TEST_ORACLE_WITH_OPTIONS_COMMON,
    schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
    heartbeat.table.name = '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE',
    heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;
"""],
    after_sqls_hook=check_heartbeat_creation_error,
    after_sqls_hook_kwargs={
        "owner": "$TEST_ORACLE_SOURCE_SCHEMA",
        "expected_message": "needs UPDATE permission on heartbeat table '$TEST_ORACLE_SOURCE_SCHEMA.$TEST_ORACLE_HEARTBEAT_TABLE'",
        "create_table": False, "insert_seed": False,
        # Failed validation must preserve the preexisting sentinel, not update it.
        "after_error_check_hook": check_heartbeat_seed,
        "after_error_check_hook_kwargs": {
            "owner": "$TEST_ORACLE_SOURCE_SCHEMA", "allowed_values": [7],
        },
    },
)
PY

# Initialization must not repair or overwrite an incompatible existing table.
system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls([
    "CREATE TABLE $TEST_ORACLE_USER.$TEST_ORACLE_HEARTBEAT_TABLE "
    "(ID NUMBER(1) PRIMARY KEY, HEARTBEAT VARCHAR2(20) NOT NULL)",
    "INSERT INTO $TEST_ORACLE_USER.$TEST_ORACLE_HEARTBEAT_TABLE (ID, HEARTBEAT) VALUES (1, 'unchanged')",
])
PY

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_sqls
from oracle_test_hooks import check_heartbeat_creation_error, check_incompatible_heartbeat_unchanged
execute_sqls(["""
CREATE SOURCE incompatible_oracle_hb WITH (
    $TEST_ORACLE_WITH_OPTIONS_COMMON,
    schema.name = '$TEST_ORACLE_SOURCE_SCHEMA',
    heartbeat.table.name = '$TEST_ORACLE_USER.$TEST_ORACLE_HEARTBEAT_TABLE',
    heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;
"""],
    after_sqls_hook=check_heartbeat_creation_error,
    after_sqls_hook_kwargs={
        "owner": "$TEST_ORACLE_USER",
        "expected_message": "must contain NUMBER columns named 'ID' and 'HEARTBEAT'",
        "after_error_check_hook": check_incompatible_heartbeat_unchanged,
    },
)
PY

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py drop-tables

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import execute_oracle_sqls
execute_oracle_sqls(["DROP USER IF EXISTS RW_MISSING_SCHEMA CASCADE"])
PY
