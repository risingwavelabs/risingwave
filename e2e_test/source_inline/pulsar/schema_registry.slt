control substitution on

system ok
curl "$PULSAR_HTTP_URL/admin/v2/brokers/ready"
----
ok


statement ok
drop materialized view if exists pulsar_avro_auto_mv;

statement ok
drop materialized view if exists pulsar_avro_explicit_mv;

statement ok
drop source if exists pulsar_avro_auto;

statement ok
drop source if exists pulsar_avro_explicit;

statement ok
drop source if exists pulsar_avro_mismatch;

statement ok
drop source if exists pulsar_auto_unsupported;

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-registry-avro' --force

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-registry-json' --force

system ok
python3 e2e_test/source_inline/pulsar/schema_registry.py --topic 'persistent://public/default/rw-schema-registry-avro' <<EOF
{"id":1,"name":"Alice"}
{"id":2,"name":"Bob"}
EOF

system ok
python3 e2e_test/source_inline/pulsar/schema_registry.py --schema-type json --topic 'persistent://public/default/rw-schema-registry-json' <<EOF
{"id":3,"name":"Carol"}
EOF

statement error expected Pulsar AVRO schema, got JSON
create source pulsar_avro_mismatch
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-registry-json',
  scan.startup.mode = 'earliest'
)
format plain encode avro (
  schema.registry = '${PULSAR_HTTP_URL}'
);

statement error Pulsar schema type `JSON` is not supported by `ENCODE AUTO`
create source pulsar_auto_unsupported
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-registry-json',
  scan.startup.mode = 'earliest'
)
format plain encode auto (
  schema.registry = '${PULSAR_HTTP_URL}'
);

statement ok
create source pulsar_avro_auto
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-registry-avro',
  scan.startup.mode = 'earliest'
)
format plain encode auto (
  schema.registry = '${PULSAR_HTTP_URL}'
);

statement ok
create source pulsar_avro_explicit
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-registry-avro',
  scan.startup.mode = 'earliest'
)
format plain encode avro (
  schema.registry = '${PULSAR_HTTP_URL}'
);

statement ok
create materialized view pulsar_avro_auto_mv as
select id, name from pulsar_avro_auto;

statement ok
create materialized view pulsar_avro_explicit_mv as
select id, name from pulsar_avro_explicit;

query IT rowsort retry 10 backoff 1s
select id, name from pulsar_avro_auto_mv;
----
1 Alice
2 Bob


query IT rowsort retry 10 backoff 1s
select id, name from pulsar_avro_explicit_mv;
----
1 Alice
2 Bob


statement ok
drop materialized view pulsar_avro_auto_mv;

statement ok
drop materialized view pulsar_avro_explicit_mv;

statement ok
drop source pulsar_avro_auto;

statement ok
drop source pulsar_avro_explicit;

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-registry-avro' --force

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-registry-json' --force
