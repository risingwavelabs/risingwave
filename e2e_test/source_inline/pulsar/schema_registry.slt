control substitution on

system ok
curl "$PULSAR_HTTP_URL/admin/v2/brokers/ready"
----
ok


statement ok
drop materialized view if exists pulsar_avro_schema_mv;

statement ok
drop source if exists pulsar_avro_schema;

statement ok
drop source if exists pulsar_avro_schema_mismatch;

statement ok
drop source if exists pulsar_avro_schema_upsert;

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-avro' --force

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-json' --force

system ok
python3 e2e_test/source_inline/pulsar/produce_schema_test_records.py --topic 'persistent://public/default/rw-schema-avro' <<EOF
{"id":1,"name":"Alice"}
EOF

system ok
python3 e2e_test/source_inline/pulsar/produce_schema_test_records.py --schema-version 1 --topic 'persistent://public/default/rw-schema-avro' <<EOF
{"id":2,"name":"Bob","category":"premium"}
EOF

system ok
python3 e2e_test/source_inline/pulsar/produce_schema_test_records.py --topic 'persistent://public/default/rw-schema-avro' <<EOF
{"id":3,"name":"Carol"}
EOF

system ok
python3 e2e_test/source_inline/pulsar/produce_schema_test_records.py --schema-type json --topic 'persistent://public/default/rw-schema-json' <<EOF
{"id":3,"name":"Carol"}
EOF

statement error expected Pulsar AVRO schema, got JSON
create source pulsar_avro_schema_mismatch
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-json',
  scan.startup.mode = 'earliest'
)
format plain encode avro (
  schema.pulsar.url = '${PULSAR_HTTP_URL}'
);

statement error Pulsar schema requires connector = 'pulsar' with FORMAT PLAIN ENCODE AVRO
create source pulsar_avro_schema_upsert
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-avro',
  scan.startup.mode = 'earliest'
)
format upsert encode avro (
  schema.pulsar.url = '${PULSAR_HTTP_URL}'
);

statement ok
create source pulsar_avro_schema
with (
  connector = 'pulsar',
  service.url = '${PULSAR_BROKER_URL}',
  topic = 'persistent://public/default/rw-schema-avro',
  scan.startup.mode = 'earliest'
)
format plain encode avro (
  schema.pulsar.url = '${PULSAR_HTTP_URL}'
);

statement ok
create materialized view pulsar_avro_schema_mv as
select id, name, category from pulsar_avro_schema;

query ITT rowsort retry 10 backoff 1s
select id, name, category from pulsar_avro_schema_mv;
----
1 Alice unknown
2 Bob premium
3 Carol unknown


statement ok
drop materialized view pulsar_avro_schema_mv;

statement ok
drop source pulsar_avro_schema;

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-avro' --force

system ok
python3 e2e_test/commands/pulsar_util.py drop-topic -t 'persistent://public/default/rw-schema-json' --force
