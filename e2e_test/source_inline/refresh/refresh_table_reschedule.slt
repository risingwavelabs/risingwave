# A table cannot be rescheduled while it is being refreshed; the alter goes through once the
# cycle ends.

include ./refresh_table_200k.slt.part

statement ok
REFRESH TABLE refresh_200k_t;

statement error is being refreshed
ALTER TABLE refresh_200k_t SET PARALLELISM = 1;

query T retry 12 backoff 5s
SELECT s.current_status
FROM rw_catalog.rw_refresh_table_state s
JOIN rw_catalog.rw_tables t ON s.table_id = t.id
WHERE t.name = 'refresh_200k_t';
----
IDLE


statement ok
ALTER TABLE refresh_200k_t SET PARALLELISM = 1;

statement ok retry 3 backoff 5s
REFRESH TABLE refresh_200k_t;

query T retry 12 backoff 5s
SELECT s.current_status
FROM rw_catalog.rw_refresh_table_state s
JOIN rw_catalog.rw_tables t ON s.table_id = t.id
WHERE t.name = 'refresh_200k_t';
----
IDLE


query II
SELECT count(*), sum(cnt) FROM refresh_200k_mv;
----
97 200000


include ./drop_refresh_table_200k.slt.part
