control substitution on

# `ALTER ... CONNECTOR WITH (properties.bootstrap.server = ...)` for Kafka sources and tables.
#
# Only a single broker is available here, so the objects are re-pointed to the same broker through
# a duplicated address list. This is the supported use case: address changes of the same logical
# cluster, where the partition offsets stay valid. Cross-cluster cases are covered by
# `e2e_test/kafka-sasl/alter_bootstrap_server.slt`.

system ok
rpk topic create test_alter_bootstrap_server -p 2

system ok
cat <<EOF | rpk topic produce test_alter_bootstrap_server -f "%v\n"
{"x": 1}
{"x": 2}
{"x": 3}
EOF

# ==== shared source ====

statement ok
create source s_alter_bs (x int) with (
    ${RISEDEV_KAFKA_WITH_OPTIONS_COMMON},
    topic = 'test_alter_bootstrap_server'
) format plain encode json;

statement ok
create materialized view mv_alter_bs as select * from s_alter_bs;

query I retry 3 backoff 5s
select count(*) from mv_alter_bs;
----
3

# An unreachable broker is rejected, and the catalog is left untouched.
statement error failed to fetch metadata from kafka \(unreachable.invalid:9092\)
alter source s_alter_bs connector with (properties.bootstrap.server = 'unreachable.invalid:9092');

query I
select count(*) from rw_sources
where name = 's_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}''%';
----
1

statement ok
alter source s_alter_bs connector with (
    properties.bootstrap.server = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}'
);

query I
select count(*) from rw_sources
where name = 's_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}''%';
----
1

system ok
cat <<EOF | rpk topic produce test_alter_bootstrap_server -f "%v\n"
{"x": 4}
{"x": 5}
{"x": 6}
EOF

# The offsets are kept: nothing is skipped or ingested twice.
query I retry 3 backoff 5s
select * from mv_alter_bs order by x;
----
1
2
3
4
5
6

# ==== table with connector, created with the legacy alias `kafka.brokers` ====

statement ok
create table t_alter_bs (x int) with (
    connector = 'kafka',
    kafka.brokers = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}',
    topic = 'test_alter_bootstrap_server'
) format plain encode json;

query I retry 3 backoff 5s
select count(*) from t_alter_bs;
----
6

# Altering the canonical key replaces the alias instead of keeping both.
statement ok
alter table t_alter_bs connector with (
    properties.bootstrap.server = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}'
);

query I
select count(*) from rw_tables
where name = 't_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}''%'
  and definition not ilike '%kafka.brokers%';
----
1

query I
select count(*) from rw_sources
where name = 't_alter_bs'
  and definition ilike '%properties.bootstrap.server = ''${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}''%'
  and definition not ilike '%kafka.brokers%';
----
1

system ok
cat <<EOF | rpk topic produce test_alter_bootstrap_server -f "%v\n"
{"x": 7}
{"x": 8}
{"x": 9}
EOF

query I retry 3 backoff 5s
select count(*) from t_alter_bs;
----
9

# ==== connection ====

statement ok
create connection conn_alter_bs with (
    type = 'kafka',
    properties.bootstrap.server = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}'
);

statement ok
create source s_alter_bs_conn (x int) with (
    connector = 'kafka',
    connection = conn_alter_bs,
    topic = 'test_alter_bootstrap_server'
) format plain encode json;

# A property set by the CONNECTION cannot be altered on the source.
statement error Cannot alter connector properties that are set by CONNECTION
alter source s_alter_bs_conn connector with (properties.bootstrap.server = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}');

statement ok
alter connection conn_alter_bs connector with (
    properties.bootstrap.server = '${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}'
);

query I
select count(*) from rw_connections
where name = 'conn_alter_bs'
  and connection_params like '%${RISEDEV_KAFKA_BOOTSTRAP_SERVERS},${RISEDEV_KAFKA_BOOTSTRAP_SERVERS}%';
----
1

# ==== clean up ====

statement ok
drop source s_alter_bs_conn;

statement ok
drop connection conn_alter_bs;

statement ok
drop table t_alter_bs;

statement ok
drop source s_alter_bs cascade;

system ok
rpk topic delete test_alter_bootstrap_server
