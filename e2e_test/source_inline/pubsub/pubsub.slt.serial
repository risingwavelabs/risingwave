control substitution on

system ok
e2e_test/source_inline/pubsub/prepare-data.rs create

statement error missing field `pubsub.subscription`
CREATE SOURCE s (v1 int, v2 varchar) WITH (
    connector = 'google_pubsub'
) FORMAT PLAIN ENCODE JSON;

statement error failed to lookup address information
CREATE TABLE s (v1 int, v2 varchar) WITH (
    connector = 'google_pubsub',
    pubsub.subscription = 'test-subscription-1',
    pubsub.emulator_host = 'invalid_host:5981'
) FORMAT PLAIN ENCODE JSON;

statement error subscription test-subscription-not-exist does not exist
CREATE TABLE s (v1 int, v2 varchar) WITH (
    ${RISEDEV_PUBSUB_WITH_OPTIONS_COMMON},
    pubsub.subscription = 'test-subscription-not-exist',
) FORMAT PLAIN ENCODE JSON;

# fail if ack_deadline_seconds is out of range
statement error pubsub.ack_deadline_seconds must be between 10 and 600
CREATE TABLE s (v1 int, v2 varchar) WITH (
    ${RISEDEV_PUBSUB_WITH_OPTIONS_COMMON},
    pubsub.subscription = 'test-subscription-1',
    pubsub.ack_deadline_seconds = 601
) FORMAT PLAIN ENCODE JSON;

# fail if both start_offset and start_snapshot are provided
statement error specify at most one of start_offset or start_snapshot
CREATE TABLE s (v1 int, v2 varchar) WITH (
    ${RISEDEV_PUBSUB_WITH_OPTIONS_COMMON},
    pubsub.subscription = 'test-subscription-3',
    pubsub.start_offset.nanos = '121212',
    pubsub.start_snapshot = 'snapshot-that-doesnt-exist'
) FORMAT PLAIN ENCODE JSON;

statement ok
CREATE DATABASE pubsub_input_db WITH CHECKPOINT_FREQUENCY = 114514;

statement ok
CREATE DATABASE pubsub_observer_db WITH CHECKPOINT_FREQUENCY = 1;

statement ok
SET DATABASE TO pubsub_observer_db;

statement ok
CREATE TABLE observed (v1 int, v2 varchar) WITH (
    ${RISEDEV_PUBSUB_WITH_OPTIONS_COMMON},
    pubsub.subscription = 'test-observation-subscription',
    pubsub.ack_deadline_seconds = 10
) FORMAT PLAIN ENCODE JSON;

statement ok
SET DATABASE TO pubsub_input_db;

statement ok
CREATE TABLE s1 (v1 int, v2 varchar) WITH (
    ${RISEDEV_PUBSUB_WITH_OPTIONS_COMMON},
    pubsub.subscription = 'test-subscription-1',
    pubsub.ack_deadline_seconds = 10
) FORMAT PLAIN ENCODE JSON;

statement ok
CREATE SINK observation_sink FROM s1 WITH (
    connector = 'google_pubsub',
    pubsub.endpoint = '${PUBSUB_EMULATOR_HOST}',
    pubsub.emulator_host = '${PUBSUB_EMULATOR_HOST}',
    pubsub.topic = 'test-observation-topic'
) FORMAT PLAIN ENCODE JSON (force_append_only = 'true');

# Publish data after table creation, because DDL triggers checkpoint.
system ok
e2e_test/source_inline/pubsub/prepare-data.rs publish

# No checkpoint has happened, so checkpoint visibility shows 0.
query I
select count(*) from s1;
----
0

statement ok
SET DATABASE TO pubsub_observer_db;

# Wait for all 10 messages to be consumed. The emulator may or may not redeliver
# while the stream is active, so only assert the distinct payloads we care about.
query I retry 60 backoff 1s
select count(distinct v1) from observed;
----
10

statement ok
SET DATABASE TO pubsub_input_db;

# Recovery: uncheckpointed data is lost, stream disconnects.
statement ok
RECOVER;

sleep 1s

# After recovery, uncheckpointed data is lost.
query I
select count(*) from s1;
----
0

statement ok
ALTER DATABASE pubsub_input_db SET CHECKPOINT_FREQUENCY = 1;

# Wait for redelivery. Poll instead of a fixed sleep, because the emulator's
# streaming-pull redelivery timing is non-deterministic.
query I retry 60 backoff 5s
select count(distinct v1) from s1;
----
10

# Flush forces a checkpoint (and acks Pub/Sub messages on checkpoint).
statement ok
flush;

# Wait a full ack-deadline window for any post-checkpoint redeliveries to surface.
# Use retry instead of fixed sleep -- emulator timing is non-deterministic on slow CI.
query I retry 20 backoff 1s
select count(distinct v1) from s1;
----
10

statement ok
DROP SINK observation_sink;

statement ok
DROP TABLE s1;

statement ok
SET DATABASE TO pubsub_observer_db;

statement ok
DROP TABLE observed;

statement ok
SET DATABASE TO dev;

statement ok
DROP DATABASE pubsub_input_db;

statement ok
DROP DATABASE pubsub_observer_db;
