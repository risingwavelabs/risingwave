# CDC validation tests, primarily using shared sources.
#
# These tests verify that invalid CDC source and table definitions are rejected
# during creation.

control substitution on


############################################################
# CDC: Debezium decimal handling mode validation.
############################################################

# Precise mode emits binary logical decimals that RisingWave cannot decode safely from
# schema-less JSON.
statement error 'debezium.decimal.handling.mode' must be 'string', got: 'precise'
create source mysql_invalid_decimal_precise with (
 connector = 'mysql-cdc',
 hostname = 'mysql',
 port = '3306',
 username = 'root',
 password = '123456',
 database.name = 'my@db',
 server.id = '5802',
 debezium.decimal.handling.mode = 'precise'
);

# Double mode can lose decimal precision.
statement error 'debezium.decimal.handling.mode' must be 'string', got: 'double'
create source mysql_invalid_decimal_double with (
 connector = 'mysql-cdc',
 hostname = 'mysql',
 port = '3306',
 username = 'root',
 password = '123456',
 database.name = 'my@db',
 server.id = '5803',
 debezium.decimal.handling.mode = 'double'
);


############################################################
# CDC: Debezium heartbeat interval validation.
############################################################

statement error 'debezium.heartbeat.interval.ms' must be a positive integer, got: '0'
create source mysql_invalid_heartbeat_zero with (
 connector = 'mysql-cdc',
 hostname = 'mysql',
 port = '3306',
 username = 'root',
 password = '123456',
 database.name = 'my@db',
 server.id = '5802',
 debezium.heartbeat.interval.ms = '0'
);

statement error 'debezium.heartbeat.interval.ms' must be a positive integer, got: '-1'
create source mysql_invalid_heartbeat_negative with (
 connector = 'mysql-cdc',
 hostname = 'mysql',
 port = '3306',
 username = 'root',
 password = '123456',
 database.name = 'my@db',
 server.id = '5803',
 debezium.heartbeat.interval.ms = '-1'
);

statement error 'debezium.heartbeat.interval.ms' must be a positive integer, got: 'invalid'
create source mysql_invalid_heartbeat_non_integer with (
 connector = 'mysql-cdc',
 hostname = 'mysql',
 port = '3306',
 username = 'root',
 password = '123456',
 database.name = 'my@db',
 server.id = '5804',
 debezium.heartbeat.interval.ms = 'invalid'
);


############################################################
# Oracle: connector configuration errors fire at `CREATE SOURCE`.
############################################################

# invalid user-provided heartbeat action query
statement error 'debezium.heartbeat.action.query' is generated internally; configure 'heartbeat.table.name' instead
create source oracle_user_provided_heartbeat_action with (
 connector = 'oracle-cdc',
 hostname = 'oracle',
 port = '1521',
 username = 'C##RW_VALIDATOR',
 password = 'secret',
 database.name = 'FREE',
 database.pdb.name = 'FREEPDB1',
 schema.name = 'APP',
 heartbeat.table.name = 'APP.RW_HEARTBEAT',
 debezium.heartbeat.action.query = 'UPDATE APP.RW_HEARTBEAT SET HEARTBEAT = 1 WHERE ID = 1'
);

# invalid PDB identifier
statement error 'database.pdb.name' must be an unquoted Oracle identifier
create source oracle_invalid_pdb_identifier with (
 connector = 'oracle-cdc',
 hostname = 'oracle',
 port = '1521',
 username = 'C##RW_VALIDATOR',
 password = 'secret',
 database.name = 'FREE',
 database.pdb.name = 'FREEPDB1; DROP TABLE APP.CUSTOMERS',
 schema.name = 'APP',
 heartbeat.table.name = 'APP.RW_HEARTBEAT'
);


# invalid auto schema change option
statement error Oracle CDC auto schema change is not supported
create source oracle_invalid_schema_change with (
 ${RISEDEV_ORACLE_WITH_OPTIONS_COMMON},
 schema.name = 'APP',
 auto.schema.change = 'true'
) FORMAT PLAIN ENCODE JSON;


############################################################
# Oracle: schema-level errors fire at `CREATE TABLE FROM SOURCE`.
############################################################

statement ok
drop source if exists oracle_validate_src cascade;

system ok
PYTHONPATH=e2e_test/source_inline/cdc/oracle python3 - <<'PY'
from oracle_test_utils import prepare, execute_oracle_sqls, TEST_ORACLE_SOURCE_SCHEMA
from oracle_test_hooks import no_op
prepare(create_heartbeat_tables_hook=no_op)
execute_oracle_sqls([
    f"CREATE TABLE {TEST_ORACLE_SOURCE_SCHEMA}.CUSTOMERS (ID NUMBER(9) PRIMARY KEY, NAME VARCHAR2(100))",
    f"ALTER TABLE {TEST_ORACLE_SOURCE_SCHEMA}.CUSTOMERS ADD SUPPLEMENTAL LOG DATA (ALL) COLUMNS",
    f"INSERT INTO {TEST_ORACLE_SOURCE_SCHEMA}.CUSTOMERS (ID, NAME) VALUES (1, 'RisingWave')",
])
PY

statement ok
create source oracle_validate_src with (
 ${RISEDEV_ORACLE_WITH_OPTIONS_COMMON},
 schema.name = 'APP',
 heartbeat.table.name = 'C##RW_VALIDATOR.RW_HEARTBEAT',
 heartbeat.table.auto.initialize = 'true'
) FORMAT PLAIN ENCODE JSON;

# invalid upstream table name (missing schema)
statement error (?s).*Invalid Oracle CDC table name.*expected schema.table.*
create table oracle_invalid_table_name (*)
from oracle_validate_src table 'CUSTOMERS';

# invalid upstream table name (quoted identifier)
statement error (?s).*Invalid Oracle CDC table name.*expected unquoted schema.table identifiers.*
create table oracle_invalid_quoted_name (*)
from oracle_validate_src table 'APP."CUSTOMERS"';

# invalid upstream table name (table does not exist)
statement error (?s).*Oracle table 'APP.RW_DOES_NOT_EXIST' has no visible columns.*
create table oracle_missing_upstream (*)
from oracle_validate_src table 'APP.RW_DOES_NOT_EXIST';

query I
select count(*) from rw_catalog.rw_relations
where name in ('oracle_invalid_schema_change', 'oracle_invalid_table_name',
               'oracle_invalid_quoted_name', 'oracle_missing_upstream');
----
0

# valid upstream table
statement ok
create table oracle_validate_control ("ID" INT PRIMARY KEY, "NAME" VARCHAR)
from oracle_validate_src table 'APP.CUSTOMERS';

query T retry 30 backoff 1s
select "ID", "NAME" from oracle_validate_control;
----
1 RisingWave

statement ok
drop source oracle_validate_src cascade;

system ok
python3 e2e_test/source_inline/cdc/oracle/oracle_test_utils.py cleanup


############################################################
