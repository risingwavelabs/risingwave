+static POINT_STAGES: std::sync::Mutex<[Option<Instant>; 3]> = std::sync::Mutex::new([None; 3]);
+pub(super) fn mark_point(id: HummockSstableObjectId, stage: usize) {
+    if id.as_raw_id() == 5 { POINT_STAGES.lock().unwrap()[stage] = Some(Instant::now()); if stage == 1 { *POINT_RECEIVE_THREAD.lock().unwrap() = Some(std::thread::current().id()); } }
+}
+
+static PREDECODED: std::sync::OnceLock<std::collections::HashMap<(u64, usize), Block>> = std::sync::OnceLock::new();
+static SKIP_SCAN_DECODE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+static DECODE_EVENTS: std::sync::Mutex<Vec<(u64, usize, std::thread::ThreadId, Instant, Instant)>> = std::sync::Mutex::new(Vec::new());
+static POINT_RECEIVE_THREAD: std::sync::Mutex<Option<std::thread::ThreadId>> = std::sync::Mutex::new(None);
+pub(super) fn decode_probe(id: HummockSstableObjectId, index: usize, data: bytes::Bytes, capacity: usize) -> HummockResult<Box<Block>> {
+    let start = Instant::now();
+    let block = if (1..=4).contains(&id.as_raw_id()) && *SKIP_SCAN_DECODE.get().unwrap() {
+        Box::new(PREDECODED.get().unwrap()[&(id.as_raw_id(), index)].clone())
+    } else { Box::new(Block::decode(data, capacity)?) };
+    let end = Instant::now();
+    DECODE_EVENTS.lock().unwrap().push((id.as_raw_id(), index, std::thread::current().id(), start, end));
+    Ok(block)
+}
+fn summarize_decodes(io: [Instant; 5]) -> ([f64; 6], Vec<(u64, usize, String, f64, f64)>) {
+    let events = DECODE_EVENTS.lock().unwrap();
+    let receiver = POINT_RECEIVE_THREAD.lock().unwrap().unwrap();
+    let overlap = |start: Instant, end: Instant| end.min(io[4]).saturating_duration_since(start.max(io[3])).as_secs_f64()*1e6;
+    let scans: Vec<_> = events.iter().filter(|(id,_,_,_,_)| (1..=4).contains(id)).collect();
+    assert_eq!(scans.len(), 64);
+    let threads: std::collections::HashSet<_> = scans.iter().map(|x| x.2).collect();
+    let total: f64 = scans.iter().map(|x| x.4.duration_since(x.3).as_secs_f64()*1e6).sum();
+    let receiver_overlap: f64 = scans.iter().filter(|x| x.2 == receiver).map(|x| overlap(x.3,x.4)).sum();
+    let all_overlap: f64 = scans.iter().map(|x| overlap(x.3,x.4)).sum();
+    let raw = scans.iter().map(|x| (x.0,x.1,format!("{:?}",x.2),
+        if x.3 >= io[3] { x.3.duration_since(io[3]).as_secs_f64()*1e6 } else { -io[3].duration_since(x.3).as_secs_f64()*1e6 },
+        if x.4 >= io[3] { x.4.duration_since(io[3]).as_secs_f64()*1e6 } else { -io[3].duration_since(x.4).as_secs_f64()*1e6 })).collect();
+    ([total,receiver_overlap,all_overlap,io[4].duration_since(io[3]).as_secs_f64()*1e6,scans.len() as f64,threads.len() as f64],raw)
+}
 
