diff --git a/src/storage/src/hummock/sstable_store/locality_read_window.rs b/src/storage/src/hummock/sstable_store/locality_read_window.rs
new file mode 100644
--- /dev/null
+++ b/src/storage/src/hummock/sstable_store/locality_read_window.rs
@@ -0,0 +1,75 @@
+// Copyright 2026 RisingWave Labs
+// SPDX-License-Identifier: Apache-2.0
+
+// Experimental Locality-only raw byte sharing, enabled only with the test feature.
+// Foyer still owns every block fetch. This plan can overlap an existing producer.
+use std::ops::Range;
+use std::sync::Arc;
+
+use bytes::Bytes;
+use risingwave_object_store::object::{
+    ObjectError, ObjectErrorInner, ObjectResult, ObjectStoreRef,
+};
+use tokio::sync::OnceCell;
+
+use super::{Sstable, SstableBlockIndex, SstableStore};
+
+struct ReadRun {
+    range: Range<usize>,
+    data: OnceCell<Result<Bytes, Arc<ObjectError>>>,
+}
+
+pub(crate) struct LocalityReadWindow {
+    runs: Vec<ReadRun>,
+}
+
+impl LocalityReadWindow {
+    pub(crate) fn new(store: &SstableStore, sst: &Sstable, blocks: Range<usize>) -> Self {
+        let mut runs = Vec::new();
+        let mut first = blocks.start;
+        for next in blocks.start..=blocks.end {
+            let warm = next == blocks.end
+                || store.block_cache().memory().contains(&SstableBlockIndex {
+                    sst_id: sst.id,
+                    block_idx: next as _,
+                });
+            if warm {
+                if next - first > 1 {
+                    let start = &sst.meta.block_metas[first];
+                    let end = &sst.meta.block_metas[next - 1];
+                    runs.push(ReadRun {
+                        range: start.offset as usize..(end.offset + end.len) as usize,
+                        data: OnceCell::new(),
+                    });
+                }
+                first = next + 1;
+            }
+        }
+        Self { runs }
+    }
+
+    pub(crate) async fn read(
+        &self,
+        store: &ObjectStoreRef,
+        path: &str,
+        range: Range<usize>,
+    ) -> ObjectResult<Bytes> {
+        let Some(run) = self
+            .runs
+            .iter()
+            .find(|run| run.range.start <= range.start && run.range.end >= range.end)
+        else {
+            return store.read(path, range).await;
+        };
+        match run
+            .data
+            .get_or_init(|| async { store.read(path, run.range.clone()).await.map_err(Arc::new) })
+            .await
+        {
+            Ok(bytes) => {
+                Ok(bytes.slice(range.start - run.range.start..range.end - run.range.start))
+            }
+            Err(error) => Err(ObjectErrorInner::SharedRead(error.clone()).into()),
+        }
+    }
+}
